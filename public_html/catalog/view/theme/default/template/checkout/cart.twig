<section class="checkout-block">
	<h2 class="checkout-block-title">{{ text_cart }}</h2>
	<div class="checkout-block-body">
		{% if error_warning %}
			<p class="checkout-cart-warning">{{ error_warning }}</p>
		{% endif %}

		<div class="checkout-cart-list">
			{% for product in products %}
				<div class="cart-item{% if not product.stock %} is-stock{% endif %}">
					{% if product.thumb %}
						<a href="{{ product.href }}" class="cart-item-image">
							<img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" width="80" height="80" />
						</a>
					{% endif %}

					<div class="cart-item-body">
						<div class="cart-item-top">
							<div class="min-w-0">
								<a href="{{ product.href }}" class="cart-item-name">{{ product.name }}</a>
								{% for option in product.option %}
									<p class="cart-item-option">{{ option.name }}: {{ option.value }}</p>
								{% endfor %}
								{% if product.price %}
									<p class="cart-item-price">{{ product.price }}</p>
								{% endif %}
							</div>

							<button
								type="button"
								class="button-destructive"
								data-type="icon"
								data-size="small"
								data-checkout-remove="{{ product.cart_id }}"
								title="{{ button_remove }}"
								aria-label="{{ button_remove }}"
							>
								<svg aria-hidden="true" viewBox="0 0 24 24">
									<use href="/assets/icons/sprite.svg#icon-trash"></use>
								</svg>
							</button>
						</div>

						<div class="cart-item-bottom">
							<div class="product-qty">
								<button type="button" class="button-secondary" data-type="icon" data-size="small" data-checkout-step="minus" aria-label="-">-</button>
								<input
									class="input text-center"
									data-size="sm"
									type="number"
									value="{{ product.quantity }}"
									min="{{ product.minimum }}"
									data-checkout-qty="{{ product.cart_id }}"
								/>
								<button type="button" class="button-secondary" data-type="icon" data-size="small" data-checkout-step="plus" aria-label="+">+</button>
							</div>

							{% if product.total %}
								<p class="cart-item-total">{{ product.total }}</p>
							{% endif %}
						</div>
					</div>
				</div>
			{% endfor %}

			{% for voucher in vouchers %}
				<div class="cart-item">
					<div class="cart-item-body">
						<div class="cart-item-top">
							<p class="cart-item-name">{{ voucher.description }}</p>
							<button
								type="button"
								class="button-destructive"
								data-type="icon"
								data-size="small"
								data-checkout-remove="{{ voucher.key }}"
								title="{{ button_remove }}"
								aria-label="{{ button_remove }}"
							>
								<svg aria-hidden="true" viewBox="0 0 24 24">
									<use href="/assets/icons/sprite.svg#icon-trash"></use>
								</svg>
							</button>
						</div>
						<p class="cart-item-total">{{ voucher.amount }}</p>
					</div>
				</div>
			{% endfor %}
		</div>

		{% include "default/template/checkout/totals.twig" %}
	</div>
</section>
