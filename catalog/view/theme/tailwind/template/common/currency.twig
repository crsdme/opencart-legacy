{% if (currencies | length) > 1 %}
	<div class="dropdown" data-align="center" data-dropdown data-type="hover">
		<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-currency">
			<button class="button-secondary" type="button" data-dropdown-button>
				<svg aria-hidden="true" viewbox="0 0 24 24">
					<use href="/assets/icons/sprite.svg#icon-currency"></use>
				</svg>
			</button>

			<div class="dropdown-menu" data-dropdown-menu>
				{% for currency in currencies %}
					{% if currency.symbol_left %}
						<button class="dropdown-item" type="button" name="{{ currency.code }}">{{ currency.symbol_left }} {{ currency.title }}</button>
					{% else %}
						<button class="dropdown-item" type="button" name="{{ currency.code }}">{{ currency.title }} {{ currency.symbol_right }}</button>
					{% endif %}
				{% endfor %}
			</div>
			<input type="hidden" name="code" value="" />
			<input type="hidden" name="redirect" value="{{ redirect }}" />
		</form>
	</div>
{% endif %}
