<div id="account-login" class="container mx-auto py-4">
	<div class="mx-auto px-2">
		{% include "tailwind/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-lg px-2">
		<section class="flex flex-col rounded-lg bg-white p-6 shadow">
			<h2 class="mb-2 text-xl font-bold">{{ text_returning_customer }}</h2>
			<p class="text-neutral-500">
				{{ text_i_am_returning_customer }}
			</p>
			<form action="{{ action }}" method="post" enctype="multipart/form-data" class="mt-4 flex flex-col gap-4">
				<div>
					<label for="input-email" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_email }}</label>
					<input
						type="text"
						name="email"
						value="{{ email }}"
						placeholder="{{ entry_email }}"
						id="input-email"
						autocomplete="email"
						class="input w-full"
					/>
				</div>
				<div>
					<label for="input-password" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_password }}</label>
					<input
						type="password"
						name="password"
						value="{{ password }}"
						placeholder="{{ entry_password }}"
						id="input-password"
						autocomplete="current-password"
						class="input w-full"
					/>
					<div class="mt-1 flex justify-end">
						<a href="{{ forgotten }}" class="text-primary text-sm hover:underline">{{ text_forgotten }}</a>
					</div>
				</div>

				{% if success %}
					<div class="relative rounded border border-green-200 bg-green-100 px-4 py-3 text-green-500" role="alert">
						<span class="block sm:inline">{{ success }}</span>
					</div>
				{% endif %}
				{% if error_warning %}
					<div class="relative rounded border border-red-200 bg-red-100 px-4 py-3 text-red-500" role="alert">
						<span class="block sm:inline">{{ error_warning }}</span>
					</div>
				{% endif %}

				<div class="flex flex-col gap-3 sm:flex-row">
					<a href="{{ register }}" class="button-secondary w-full sm:flex-1">{{ text_register }}</a>
					<button type="submit" class="button-primary w-full sm:flex-1">{{ button_login }}</button>
				</div>
				{% if redirect %}
					<input type="hidden" name="redirect" value="{{ redirect }}" />
				{% endif %}
			</form>
		</section>
	</div>
</div>
