<div id="account-newsletter" class="container mx-auto pb-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-lg px-2 pb-8">
		<section class="flex flex-col rounded-lg bg-white p-6 shadow">
			<h1 class="mb-4 text-xl font-bold">{{ heading_title }}</h1>

			<form action="{{ action }}" method="post" enctype="multipart/form-data" class="flex flex-col gap-6">
				<div>
					<span class="mb-2 block text-sm font-medium text-gray-700">{{ entry_newsletter }}</span>
					<div class="grid gap-2">
						<label class="flex items-center gap-2 text-sm">
							<input type="radio" name="newsletter" value="1" class="radio"{% if newsletter %} checked="checked"{% endif %} />
							<span>{{ text_yes }}</span>
						</label>
						<label class="flex items-center gap-2 text-sm">
							<input type="radio" name="newsletter" value="0" class="radio"{% if not newsletter %} checked="checked"{% endif %} />
							<span>{{ text_no }}</span>
						</label>
					</div>
				</div>
				<div class="flex flex-col gap-3 sm:flex-row">
					<a href="{{ back }}" class="button-secondary w-full sm:flex-1">{{ button_back }}</a>
					<button type="submit" class="button-primary w-full sm:flex-1">{{ button_continue }}</button>
				</div>
			</form>
		</section>
	</div>
</div>
