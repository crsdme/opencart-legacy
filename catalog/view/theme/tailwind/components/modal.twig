<div class="modal" data-modal>
	<div class="modal-content">
		<div class="modal-header">
			<h2 class="modal-title">Modal</h2>
			<button class="button-ghost" type="button" data-type="icon" data-modal-close>
				<svg aria-hidden="true" viewbox="0 0 24 24">
					<use href="/assets/icons/sprite.svg#icon-close"></use>
				</svg>
			</button>
		</div>
		<div class="modal-body">
			<p>
				Modal Body
			</p>
		</div>
		<div class="modal-footer">
			<button class="button-primary">Close</button>
		</div>
	</div>
</div>
<div class="modal-overlay" data-modal-overlay></div>

<div class="button-primary" type="button" data-modal-open="[data-modal]">
	Open Modal
</div>

<script>
	let activeModal = null;

	function openModal(selector) {
		activeModal = $(selector);

		activeModal.addClass('open');
		$('[data-modal-overlay]').addClass('open');
		$('#viewport').addClass('disable-scroll');
	}

	function closeModal() {
		if (!activeModal) return;

		activeModal.removeClass('open');
		$('[data-modal-overlay]').removeClass('open');
		$('#viewport').removeClass('disable-scroll');

		activeModal = null;
	}

	$(document).on('click', '[data-modal-open]', function () {
		openModal($(this).data('modal-open'));
	});

	$(document).on('click', '[data-modal-close], [data-modal-overlay]', function () {
		closeModal();
	});

	$(document).on('keydown', function (e) {
		if (e.key === 'Escape') {
			closeModal();
		}
	});
</script>
