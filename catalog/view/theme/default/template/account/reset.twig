<div id="account-reset" class="container mx-auto pb-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-lg px-2 pb-8">
		<section class="flex flex-col rounded-lg bg-white p-6 shadow">
			<h1 class="mb-2 text-xl font-bold">{{ heading_title }}</h1>
			<p class="mb-4 text-neutral-500">{{ text_password }}</p>

			<form action="{{ action }}" method="post" enctype="multipart/form-data" class="flex flex-col gap-4">
				<div>
					<label for="input-password" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_password }}</label>
					<input type="password" name="password" value="{{ password }}" id="input-password" autocomplete="new-password" class="input w-full" />
					{% if error_password %}
						<p class="form-message">{{ error_password }}</p>
					{% endif %}
				</div>
				<div>
					<label for="input-confirm" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_confirm }}</label>
					<input type="password" name="confirm" value="{{ confirm }}" id="input-confirm" autocomplete="new-password" class="input w-full" />
					{% if error_confirm %}
						<p class="form-message">{{ error_confirm }}</p>
					{% endif %}
				</div>
				<div class="flex flex-col gap-3 sm:flex-row">
					<a href="{{ back }}" class="button-secondary w-full sm:flex-1">{{ button_back }}</a>
					<button type="submit" class="button-primary w-full sm:flex-1">{{ button_continue }}</button>
				</div>
			</form>
		</section>
	</div>
</div>
