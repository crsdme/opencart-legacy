{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><h1>{{ heading_title }}</h1></div></div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title">{{ text_deleted_products }}</h3></div>
      <div class="panel-body">
        <form method="post" action="{{ action }}" class="form-horizontal">
          {% for id in product_ids %}<input type="hidden" name="product_id[]" value="{{ id }}" />{% endfor %}
          <p>{{ text_deleted_help }}</p>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_action }}</label>
            <div class="col-sm-10">
              <select name="delete_action" class="form-control">
                <option value="none">{{ text_do_nothing }}</option>
                <option value="410">410 Gone</option>
                <option value="redirect">301</option>
              </select>
            </div>
          </div>
          <div class="form-group"><label class="col-sm-2 control-label">{{ entry_target }}</label><div class="col-sm-10"><input type="text" name="target_url" class="form-control" /></div></div>
          <div class="form-group"><div class="col-sm-offset-2 col-sm-10"><button type="submit" class="btn btn-primary">{{ button_save }}</button></div></div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
