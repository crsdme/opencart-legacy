<div id="checkout-checkout" class="container mx-auto px-2 py-4">
	{% include "default/components/breadcrumbs.twig" %}

	<h1 class="heading">{{ heading_title }}</h1>

	{% if cart_empty %}
		{% include "default/template/checkout/empty.twig" %}
	{% else %}
		<form
			id="checkout"
			class="checkout"
			action="{{ action }}"
			method="post"
			novalidate
			data-phone-prefix="{{ phone_prefix }}"
			data-confirm="{{ confirm }}"
			data-error-required="{{ error_required }}"
			data-error-confirm="{{ error_confirm }}"
		>
			<div class="checkout-main">
				<div id="checkout-cart">
					{% include "default/template/checkout/cart.twig" %}
				</div>

				<div id="checkout-customer">
					{% include "default/template/checkout/customer-form.twig" %}
				</div>

				<div id="checkout-shipping-type"{% if not shipping_required %} hidden{% endif %}>
					{% include "default/template/checkout/shipping_type.twig" %}
				</div>

				<div id="checkout-shipping-extra" class="checkout-shipping-extra"{% if not shipping_extra %} hidden{% endif %}>
					{{ shipping_extra }}
				</div>

				<div id="checkout-shipping-address"{% if not show_shipping_address %} hidden{% endif %}>
					{% include "default/template/checkout/shipping_address.twig" %}
				</div>

				<div id="checkout-payment-type">
					{% include "default/template/checkout/payment.twig" %}
				</div>
			</div>

			<aside class="checkout-aside">
				<div id="checkout-summary">
					{% include "default/template/checkout/summary.twig" %}
				</div>

				<div id="checkout-agree">
					{% include "default/template/checkout/agree.twig" %}
				</div>

				<div id="checkout-payment-form"></div>
			</aside>
		</form>

		<div class="modal flex max-h-[80vh] w-[calc(100%-2rem)] flex-col gap-4 p-4 md:p-6" id="checkout-agree-modal">
			<div class="modal-header">
				<p class="heading" data-checkout-agree-title></p>
				<button type="button" class="button-secondary" data-type="icon" data-modal-close aria-label="×">
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<use href="/assets/icons/sprite.svg#icon-close"></use>
					</svg>
				</button>
			</div>
			<div class="min-h-0 flex-1 overflow-y-auto text-sm" data-checkout-agree-body></div>
		</div>
	{% endif %}
</div>
