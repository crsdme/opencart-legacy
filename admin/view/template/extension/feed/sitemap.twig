{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right">
				<a href="{{ clear_cache }}" data-toggle="tooltip" title="{{ button_clear_cache }}" class="btn btn-warning">
					<i class="fa fa-eraser"></i>
				</a>
				<button type="submit" form="form-sitemap" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
					<i class="fa fa-save"></i>
				</button>
				<a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default">
					<i class="fa fa-reply"></i>
				</a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="container-fluid">
		{% if error_warning %}
			<div class="alert alert-danger alert-dismissible">
				<i class="fa fa-exclamation-circle"></i>
				{{ error_warning }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		{% if success %}
			<div class="alert alert-success alert-dismissible">
				<i class="fa fa-check-circle"></i>
				{{ success }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
			</div>
			<div class="panel-body">
				<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-sitemap" class="form-horizontal">
					<ul class="nav nav-tabs">
						<li class="active"><a href="#tab-settings" data-toggle="tab"><i class="fa fa-cog"></i> {{ text_settings }}</a></li>
						<li><a href="#tab-branches" data-toggle="tab">{{ text_branches }}</a></li>
						<li><a href="#tab-feeds" data-toggle="tab">{{ text_feeds }}</a></li>
					</ul>
					<div class="tab-content">
						<div class="tab-pane active" id="tab-settings">
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
								<div class="col-sm-10">
									<select name="feed_sitemap_status" id="input-status" class="form-control">
										{% if feed_sitemap_status %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
									<p class="help-block">{{ help_status }}</p>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-indexed-only">{{ entry_indexed_only }}</label>
								<div class="col-sm-10">
									<select name="feed_sitemap_indexed_only" id="input-indexed-only" class="form-control">
										{% if feed_sitemap_indexed_only %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
									<p class="help-block">{{ help_indexed_only }}</p>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-multishop">{{ entry_multishop }}</label>
								<div class="col-sm-10">
									<select name="feed_sitemap_multishop" id="input-multishop" class="form-control">
										{% if feed_sitemap_multishop %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
									<p class="help-block">{{ help_multishop }}</p>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-cache-hours">{{ entry_cache_hours }}</label>
								<div class="col-sm-10">
									<input type="number" name="feed_sitemap_cache_hours" value="{{ feed_sitemap_cache_hours }}" min="0" step="1" id="input-cache-hours" class="form-control" />
									<p class="help-block">{{ help_cache_hours }}</p>
								</div>
							</div>
						</div>
						<div class="tab-pane" id="tab-branches">
							{% for branch in branches %}
								<div class="form-group">
									<label class="col-sm-2 control-label">{{ branch.entry }}</label>
									<div class="col-sm-10">
										<select name="{{ branch.key }}" class="form-control">
											{% if branch.value %}
												<option value="1" selected="selected">{{ text_enabled }}</option>
												<option value="0">{{ text_disabled }}</option>
											{% else %}
												<option value="1">{{ text_enabled }}</option>
												<option value="0" selected="selected">{{ text_disabled }}</option>
											{% endif %}
										</select>
										<p class="help-block">{{ help_branch }}</p>
									</div>
								</div>
							{% endfor %}
						</div>
						<div class="tab-pane" id="tab-feeds">
							{% for feed in data_feeds %}
								<div class="form-group">
									<label class="col-sm-2 control-label">{{ feed.name }}</label>
									<div class="col-sm-10">
										<input type="text" value="{{ feed.href }}" class="form-control" readonly />
										{% if loop.first %}
											<p class="help-block">{{ help_data_feed }}</p>
										{% endif %}
									</div>
								</div>
							{% endfor %}
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
{{ footer }}
