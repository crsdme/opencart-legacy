{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
              {% if error_name %}
              <div class="text-danger">{{ error_name }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_title }}">{{ entry_title }}</span></label>
            <div class="col-sm-10">
              <ul class="nav nav-tabs" id="language">
                {% for language in languages %}
                <li><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% for language in languages %}
                <div class="tab-pane" id="language{{ language.language_id }}">
                  <input type="text" name="module_description[{{ language.language_id }}][title]" placeholder="{{ entry_title }}" id="input-title{{ language.language_id }}" value="{{ module_description[language.language_id] ? module_description[language.language_id].title }}" class="form-control" />
                </div>
                {% endfor %}
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-limit">{{ entry_limit }}</label>
            <div class="col-sm-10">
              <input type="text" name="limit" value="{{ limit }}" placeholder="{{ entry_limit }}" id="input-limit" class="form-control" />
            </div>
          </div>
          <fieldset>
            <legend>{{ text_desktop }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-autoplay">{{ entry_autoplay }}</label>
              <div class="col-sm-10">
                <select name="use_autoplay" id="input-autoplay" class="form-control">
                  {% if use_autoplay %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-controls">{{ entry_controls }}</label>
              <div class="col-sm-10">
                <select name="use_controls" id="input-controls" class="form-control">
                  {% if use_controls %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-loop">{{ entry_loop }}</label>
              <div class="col-sm-10">
                <select name="use_loop" id="input-loop" class="form-control">
                  {% if use_loop %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-gap">{{ entry_gap }}</label>
              <div class="col-sm-10">
                <div class="input-group">
                  <input type="text" name="gap" value="{{ gap }}" placeholder="{{ entry_gap }}" id="input-gap" class="form-control" />
                  <span class="input-group-addon">px</span>
                </div>
                {% if error_gap %}
                <div class="text-danger">{{ error_gap }}</div>
                {% endif %}
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_mobile }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-autoplay-mobile">{{ entry_autoplay }}</label>
              <div class="col-sm-10">
                <select name="use_autoplay_mobile" id="input-autoplay-mobile" class="form-control">
                  {% if use_autoplay_mobile %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-controls-mobile">{{ entry_controls }}</label>
              <div class="col-sm-10">
                <select name="use_controls_mobile" id="input-controls-mobile" class="form-control">
                  {% if use_controls_mobile %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-loop-mobile">{{ entry_loop }}</label>
              <div class="col-sm-10">
                <select name="use_loop_mobile" id="input-loop-mobile" class="form-control">
                  {% if use_loop_mobile %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-gap-mobile">{{ entry_gap }}</label>
              <div class="col-sm-10">
                <div class="input-group">
                  <input type="text" name="gap_mobile" value="{{ gap_mobile }}" placeholder="{{ entry_gap }}" id="input-gap-mobile" class="form-control" />
                  <span class="input-group-addon">px</span>
                </div>
                {% if error_gap_mobile %}
                <div class="text-danger">{{ error_gap_mobile }}</div>
                {% endif %}
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_general }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-breakpoint">{{ entry_breakpoint }}</label>
              <div class="col-sm-10">
                <div class="input-group">
                  <input type="text" name="breakpoint" value="{{ breakpoint }}" placeholder="{{ entry_breakpoint }}" id="input-breakpoint" class="form-control" />
                  <span class="input-group-addon">px</span>
                </div>
                {% if error_breakpoint %}
                <div class="text-danger">{{ error_breakpoint }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-autoplay-delay">{{ entry_autoplay_delay }}</label>
              <div class="col-sm-10">
                <div class="input-group">
                  <input type="text" name="autoplay_delay" value="{{ autoplay_delay }}" placeholder="{{ entry_autoplay_delay }}" id="input-autoplay-delay" class="form-control" />
                  <span class="input-group-addon">с</span>
                </div>
                {% if error_autoplay_delay %}
                <div class="text-danger">{{ error_autoplay_delay }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
              <div class="col-sm-10">
                <select name="status" id="input-status" class="form-control">
                  {% if status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                  {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                  {% endif %}
                </select>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
  <script type="text/javascript"><!--
$('#language a:first').tab('show');
//--></script>
</div>
{{ footer }}
