<section class="checkout-block">
	<h2 class="checkout-block-title">{{ text_checkout_shipping_address }}</h2>
	<p class="checkout-block-hint">{{ text_shipping_address }}</p>
	<fieldset class="checkout-block-body checkout-fields"{% if not show_shipping_address %} disabled{% endif %}>
		{% if fields.company.show %}
			<div class="form-item{% if fields.company.required %} required{% endif %}">
				<label class="form-label" for="input-company">{{ entry_company }}</label>
				<input
					class="input w-full"
					type="text"
					name="company"
					value="{{ company }}"
					id="input-company"
					autocomplete="organization"
					data-checkout-address
					{% if fields.company.required %}required{% endif %}
				/>
			</div>
		{% endif %}

		{% if fields.city.show %}
			<div class="form-item{% if fields.city.required %} required{% endif %}">
				<label class="form-label" for="input-city">{{ entry_city }}</label>
				<input
					class="input w-full"
					type="text"
					name="city"
					value="{{ city }}"
					id="input-city"
					placeholder="{{ text_city }}"
					autocomplete="address-level2"
					data-checkout-address
					{% if fields.city.required %}required{% endif %}
				/>
			</div>
		{% endif %}

		{% if fields.address_1.show %}
			<div class="form-item{% if fields.address_1.required %} required{% endif %}">
				<label class="form-label" for="input-address-1">{{ entry_address_1 }}</label>
				<input
					class="input w-full"
					type="text"
					name="address_1"
					value="{{ address_1 }}"
					id="input-address-1"
					placeholder="{{ text_address_1 }}"
					autocomplete="address-line1"
					data-checkout-address
					{% if fields.address_1.required %}required{% endif %}
				/>
			</div>
		{% endif %}

		{% if fields.address_2.show %}
			<div class="form-item{% if fields.address_2.required %} required{% endif %}">
				<label class="form-label" for="input-address-2">{{ entry_address_2 }}</label>
				<input
					class="input w-full"
					type="text"
					name="address_2"
					value="{{ address_2 }}"
					id="input-address-2"
					autocomplete="address-line2"
					data-checkout-address
					{% if fields.address_2.required %}required{% endif %}
				/>
			</div>
		{% endif %}

		{% if fields.postcode.show %}
			<div class="form-item{% if fields.postcode.required %} required{% endif %}">
				<label class="form-label" for="input-postcode">{{ entry_postcode }}</label>
				<input
					class="input w-full"
					type="text"
					name="postcode"
					value="{{ postcode }}"
					id="input-postcode"
					autocomplete="postal-code"
					data-checkout-address
					{% if fields.postcode.required %}required{% endif %}
				/>
			</div>
		{% endif %}
	</fieldset>
</section>
