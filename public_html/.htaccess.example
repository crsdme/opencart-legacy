Options +FollowSymlinks -Indexes

<FilesMatch "(?i)((\.tpl|\.twig|\.ini|\.log|(?<!robots)\.txt))$">
	Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

ErrorDocument 410 /index.php?route=error/gone

# www -> non-www over HTTPS (skip local Docker)
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# http -> https (skip local Docker)
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Collapse multiple slashes in the path
RewriteCond %{THE_REQUEST} \s[^?]*//
RewriteRule .* /$0 [R=301,L]

# /index.php, /index.html, /index.htm -> /
RewriteCond %{THE_REQUEST} \s/+index\.(php|html?|htm)[\s?] [NC]
RewriteCond %{QUERY_STRING} ^$
RewriteRule ^index\.(php|html?|htm)$ / [R=301,L]

# Language prefixes without trailing slash
# RewriteCond %{REQUEST_URI} ^/(en|ru|ua|uk|pl|it|de|fr|es)$ [NC]
# RewriteRule ^(en|ru|ua|uk|pl|it|de|fr|es)$ /$1/ [R=301,L,NC]

# Strip page=1
RewriteCond %{QUERY_STRING} ^(.+)&page=1$
RewriteRule ^(.*)$ /$1?%1 [R=301,L]
RewriteCond %{QUERY_STRING} ^page=1$
RewriteRule ^(.*)$ /$1? [R=301,L]

# Tailwind theme images
RewriteRule ^assets(?:/(.+))?$ catalog/view/theme/default/image/$1 [L,NC,END]

# Docs screenshots from repo docs/ (when the Apache Alias is not used)
RewriteRule ^docs-media/(.+)$ index.php?route=docs/asset&path=$1 [B,L,QSA]

# XML sitemap
RewriteCond %{REQUEST_URI} ^/(?:([a-z]{2}(?:-[a-z]{2})?)/)?(sitemap(?:-[A-Za-z0-9_-]+)?)\.xml$ [NC]
RewriteRule ^(?:([a-z]{2}(?:-[a-z]{2})?)/)?(sitemap(?:-[A-Za-z0-9_-]+)?)\.xml$ index.php?route=extension/feed/sitemap&language=$1&type=$2 [L,QSA]

# Hide /admin behind /secureadmin (uncomment on production)
# RewriteRule ^secureadmin/?$ admin/index.php [L]
# RewriteRule ^secureadmin/(.*)$ admin/$1 [L]
# RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /admin
# RewriteRule ^admin(?:/.*)?$ index.php?route=error/not_found [L,QSA]

# Protect system paths
RewriteRule ^system/download/(.*) index.php?route=error/not_found [L]
RewriteRule ^system/storage/(.*) index.php?route=error/not_found [L]

# OpenCart SEO rewrite
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !.*\.(ico|gif|jpg|jpeg|png|webp|js|css|woff|woff2|svg|map)$
RewriteRule ^([^?]*) index.php?_route_=$1 [L,QSA]

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresDefault "access plus 1 day"

	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/gif "access plus 1 year"
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType image/x-icon "access plus 1 year"

	ExpiresByType font/ttf "access plus 1 year"
	ExpiresByType font/otf "access plus 1 year"
	ExpiresByType font/woff "access plus 1 year"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType application/font-woff "access plus 1 year"
	ExpiresByType application/font-woff2 "access plus 1 year"
	ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType application/x-javascript "access plus 1 year"
	ExpiresByType text/javascript "access plus 1 year"

	ExpiresByType text/html "access plus 0 seconds"
	ExpiresByType application/xhtml+xml "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
	AddType image/svg+xml .svg .svgz
	AddEncoding gzip .svgz

	<FilesMatch "\.(svg|svgz)$">
		Header set Content-Type "image/svg+xml; charset=utf-8"
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>

	<FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|ttf|otf|eot|woff|woff2|css|js)$">
		Header set Cache-Control "max-age=31536000, public, immutable"
	</FilesMatch>

	<FilesMatch "\.(mp4|webm|ogg|mp3)$">
		Header set Cache-Control "max-age=31536000, public, immutable"
	</FilesMatch>

	<FilesMatch "\.(html|htm)$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>

	<FilesMatch "\.(php)$">
		Header always unset Expires
		Header always unset Pragma
		Header always unset Cache-Control
		Header always set Cache-Control "private, no-cache, must-revalidate"
	</FilesMatch>

	<FilesMatch "\.(cgi|pl|htaccess)$">
		Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		Header set Pragma "no-cache"
	</FilesMatch>

	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

	# OpenCart: inline scripts/styles + jQuery need unsafe-inline / unsafe-eval
	# Third parties: GTM/GA, reCAPTCHA, Google Fonts/Maps, YouTube, Facebook, LiqPay
	Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://liqpay.ua https://liqpay.com https://www.liqpay.ua https://www.liqpay.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://tagmanager.google.com https://www.google-analytics.com https://ssl.google-analytics.com https://www.google.com https://www.gstatic.com https://www.google.com.ua https://googleads.g.doubleclick.net https://www.googleadservices.com https://connect.facebook.net https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.googletagmanager.com https://tagmanager.google.com https://www.gstatic.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://www.gstatic.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://www.google.com https://www.google.com.ua https://www.gstatic.com https://www.facebook.com https://connect.facebook.net https://graph.facebook.com https://maps.googleapis.com; frame-src 'self' https://www.googletagmanager.com https://www.google.com https://www.google.com.ua https://recaptcha.google.com https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://www.facebook.com https://staticxx.facebook.com https://www.liqpay.ua https://www.liqpay.com https://liqpay.ua; media-src 'self' https: data: blob:; worker-src 'self' blob:"
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html
	AddOutputFilterByType DEFLATE text/plain
	AddOutputFilterByType DEFLATE text/xml
	AddOutputFilterByType DEFLATE text/css
	AddOutputFilterByType DEFLATE text/javascript
	AddOutputFilterByType DEFLATE application/javascript
	AddOutputFilterByType DEFLATE application/x-javascript
	AddOutputFilterByType DEFLATE application/json
	AddOutputFilterByType DEFLATE application/xml
	AddOutputFilterByType DEFLATE application/rss+xml
	AddOutputFilterByType DEFLATE application/xhtml+xml
	AddOutputFilterByType DEFLATE image/svg+xml
	AddOutputFilterByType DEFLATE image/x-icon
	AddOutputFilterByType DEFLATE font/ttf
	AddOutputFilterByType DEFLATE font/otf
	AddOutputFilterByType DEFLATE font/woff
	AddOutputFilterByType DEFLATE font/woff2
	AddOutputFilterByType DEFLATE application/font-woff
	AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
</IfModule>
