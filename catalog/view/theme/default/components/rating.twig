{% set value = (rating | default(0)) + 0 %}
{% set interactive = interactive | default(false) %}
{% set input_name = name | default("rating") %}
{% set input_id = id | default("rating") %}

{% if interactive %}
	<div class="rating-input" role="radiogroup" aria-label="{{ entry_rating | default("") }}">
		{% for i in 5..1 %}
			<input type="radio" name="{{ input_name }}" value="{{ i }}" id="{{ input_id }}-{{ i }}" />
			<label class="rating-input-label" for="{{ input_id }}-{{ i }}">
				<span class="sr-only">{{ i }}</span>
				<svg class="rating-star" aria-hidden="true" viewBox="0 0 24 24">
					<path
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
					/>
				</svg>
			</label>
		{% endfor %}
	</div>
{% else %}
	<div class="rating" role="img" aria-label="{{ value }} / 5">
		{% for i in 1..5 %}
			<svg class="rating-star{% if i <= value %} is-filled{% endif %}" aria-hidden="true" viewBox="0 0 24 24">
				<path
					stroke="currentColor"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
				/>
			</svg>
		{% endfor %}
	</div>
{% endif %}
