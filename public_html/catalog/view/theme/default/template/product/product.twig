{% set class = "col-span-12 " %}
{% if column_left and column_right %}
	{% set class = class ~ "lg:col-span-6" %}
{% elseif column_left or column_right %}
	{% set class = class ~ "lg:col-span-9" %}
{% else %}
	{% set class = class ~ "lg:col-span-12" %}
{% endif %}

<div class="container mx-auto px-2">
	{% include "default/components/breadcrumbs.twig" %}
</div>
<div class="container mx-auto grid grid-cols-1 gap-6 px-2 lg:grid-cols-12">
	{{ column_left }}
	<main class="{{ class }} pb-10">
		{{ content_top }}

		<div class="product-hero flex flex-col gap-8 lg:flex-row lg:items-start">
			<section class="product-hero-col w-full lg:w-1/2" aria-label="{{ heading_title }}">
				{% include "default/components/product-gallery.twig" %}
			</section>

			<section class="product-hero-col w-full lg:w-1/2" aria-label="{{ heading_title }}">
				<form id="product-form" class="product-buy flex flex-col gap-6">
					<div class="flex flex-col gap-3">
						<h1 class="heading mb-0">{{ heading_title }}</h1>

						<div class="flex flex-wrap items-center gap-3">
							{% if review_status %}
								<div class="flex items-center gap-2">
									{% include "default/components/rating.twig" with {
										rating: rating
									} %}
									<a href="#reviews" class="text-muted link" data-scroll="#reviews">{{ reviews }}</a>
								</div>
							{% endif %}

							<div class="ml-auto flex gap-2">
								<button
									type="button"
									class="button-secondary"
									data-type="icon"
									title="{{ button_wishlist }}"
									onclick="addToWishlist({{ product_id }}, this);"
								>
									<svg aria-hidden="true" viewBox="0 0 24 24">
										<use href="/assets/icons/sprite.svg#icon-heart"></use>
									</svg>
								</button>
								<button
									type="button"
									class="button-secondary"
									data-type="icon"
									title="{{ button_compare }}"
									onclick="addToCompare({{ product_id }}, this);"
								>
									<svg aria-hidden="true" viewBox="0 0 24 24">
										<use href="/assets/icons/sprite.svg#icon-scales"></use>
									</svg>
								</button>
							</div>
						</div>
					</div>

					{% if price %}
						<div class="flex flex-col gap-1">
							<p class="product-price">
								{% if special %}
									{{ special }}
									<span class="product-price-old">{{ price }}</span>
								{% else %}
									{{ price }}
								{% endif %}
							</p>
							{% if tax %}
								<p class="text-muted">
									{{ text_tax }} {{ tax }}
								</p>
							{% endif %}
							{% if points %}
								<p class="text-muted">
									{{ text_points }} {{ points }}
								</p>
							{% endif %}
							{% if discounts %}
								{% for discount in discounts %}
									<p class="text-muted">
										{{ discount.quantity }}{{ text_discount }}{{ discount.price }}
									</p>
								{% endfor %}
							{% endif %}
						</div>
					{% endif %}

					<dl class="product-meta">
						{% if manufacturer %}
							<div>
								<dt>
									{{ text_manufacturer }}
								</dt>
								<dd><a class="link" href="{{ manufacturers }}">{{ manufacturer }}</a></dd>
							</div>
						{% endif %}
						<div>
							<dt>
								{{ text_model }}
							</dt>
							<dd>{{ model }}</dd>
						</div>
						{% if reward %}
							<div>
								<dt>
									{{ text_reward }}
								</dt>
								<dd>{{ reward }}</dd>
							</div>
						{% endif %}
						<div>
							<dt>
								{{ text_stock }}
							</dt>
							<dd>{{ stock }}</dd>
						</div>
					</dl>

					{% include "default/components/product-options.twig" %}
					{% include "default/components/product-recurrings.twig" %}

					<input type="hidden" name="product_id" value="{{ product_id }}" />

					<div class="product-buy-actions">
						<div class="form-item mb-0 w-max">
							<label class="form-label" for="input-quantity">{{ entry_qty }}</label>
							<div class="product-qty">
								<button type="button" class="button-secondary" data-type="icon" data-qty="minus" aria-label="-">-</button>
								<input class="input text-center" type="number" name="quantity" value="{{ minimum }}" min="{{ minimum }}" id="input-quantity" />
								<button type="button" class="button-secondary" data-type="icon" data-qty="plus" aria-label="+">+</button>
							</div>
						</div>

						<button
							type="button"
							class="button-primary product-buy-cart"
							id="button-cart"
							{{ in_stock ? "" : "disabled" }}
							onclick="addToCartFromForm('#product-form', this)"
						>
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<use href="/assets/icons/sprite.svg#icon-cart"></use>
							</svg>
							<span>{{ button_cart }}</span>
						</button>
					</div>

					{% if minimum > 1 %}
						<p class="form-description">
							{{ text_minimum }}
						</p>
					{% endif %}
				</form>
			</section>
		</div>

		{% if description or attribute_groups %}
			<div class="mt-10 flex flex-col gap-6 lg:flex-row lg:items-start">
				{% if description %}
					<section class="w-full {{ attribute_groups ? "lg:w-1/2" : "" }}" aria-labelledby="product-description-heading">
						<div class="product-panel text-collapse" data-collapse>
							<h2 id="product-description-heading" class="heading">{{ tab_description }}</h2>
							<div class="text-collapse-wrapper">
								<div class="content-block text-collapse-content">
									{{ description }}
								</div>
								<div class="text-collapse-overlay"></div>
							</div>
							<button
								type="button"
								class="link mt-2"
								data-collapse-toggle
								data-text-more="{{ text_show_more }}"
								data-text-less="{{ text_show_less }}"
							>
								{{ text_show_more }}
							</button>
						</div>
					</section>
				{% endif %}

				{% if attribute_groups %}
					<section class="w-full {{ description ? "lg:w-1/2" : "" }}" aria-labelledby="product-attributes-heading">
						<div class="product-panel">
							<h2 id="product-attributes-heading" class="heading">{{ tab_attribute }}</h2>
							{% for attribute_group in attribute_groups %}
								<div class="product-attributes">
									<h3 class="heading-6">{{ attribute_group.name }}</h3>
									<dl>
										{% for attribute in attribute_group.attribute %}
											<div class="product-attributes-row">
												<dt>
													{{ attribute.name }}
												</dt>
												<dd>{{ attribute.text }}</dd>
											</div>
										{% endfor %}
									</dl>
								</div>
							{% endfor %}
						</div>
					</section>
				{% endif %}
			</div>
		{% endif %}

		{% include "default/components/faq.twig" %}

		{% if review_status %}
			<section class="mb-10 mt-10" id="reviews" aria-labelledby="product-reviews-heading">
				<div class="flex flex-col gap-8 lg:flex-row lg:items-start">
					<div class="w-full lg:w-1/2">
						<h2 id="product-reviews-heading" class="heading">{{ tab_review }}</h2>
						<div id="review" data-review-url="{{ review_url }}"></div>
					</div>

					<form id="form-review" class="product-panel grid w-full gap-4 lg:w-1/2" data-write-url="{{ write_url }}">
						<h3 class="heading-5 mb-0">{{ text_write }}</h3>

						{% if review_guest %}
							<div class="form-item">
								<label class="form-label" for="input-name">{{ entry_name }}</label>
								<input class="input" type="text" name="name" value="{{ customer_name }}" id="input-name" />
							</div>
							<div class="form-item">
								<label class="form-label" for="input-review">{{ entry_review }}</label>
								<textarea class="input min-h-28 resize-y" name="text" rows="5" id="input-review"></textarea>
							</div>
							<div class="form-item">
								<span class="form-label">{{ entry_rating }}</span>
								{% include "default/components/rating.twig" with {
									interactive: true,
									name: "rating",
									id: "review-rating"
								} %}
							</div>
							{{ captcha }}
							<div class="form-item mb-0">
								<button type="button" id="button-review" class="button-primary">{{ button_continue }}</button>
							</div>
						{% else %}
							<p class="text">
								{{ text_login }}
							</p>
						{% endif %}
					</form>
				</div>
			</section>
		{% endif %}

		{% if products %}
			<section class="mt-10" aria-labelledby="product-related-heading">
				<h2 id="product-related-heading" class="heading">{{ text_related }}</h2>
				<div class="grid grid-cols-2 gap-2 sm:gap-4 xl:grid-cols-3">
					{% for product in products %}
						{% include "default/components/product-card.twig" with {
							product: product
						} %}
					{% endfor %}
				</div>
			</section>
		{% endif %}

		{% if tags %}
			<section class="mt-10" aria-label="{{ text_tags }}">
				<div class="flex flex-wrap items-center gap-2">
					<span class="text-muted">{{ text_tags }}</span>
					{% for tag in tags %}
						<a class="button-secondary" data-size="small" href="{{ tag.href }}">{{ tag.tag }}</a>
					{% endfor %}
				</div>
			</section>
		{% endif %}

		{{ content_bottom }}
	</main>
	{{ column_right }}
</div>
