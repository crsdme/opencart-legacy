<div class="live-search" data-live-search>
	<div class="live-search-input">
		<div class="input-field w-full">
			<div class="input-group" data-side="left">
				<span class="input-addon" data-side="left">
					<svg aria-hidden="true" viewBox="0 0 24 24">
						<use href="/assets/icons/sprite.svg#icon-search"></use>
					</svg>
				</span>

				<input
					class="input"
					name="search"
					value="{{ search }}"
					autocomplete="off"
					data-live-search-input
					id="live-search-input"
					type="text"
					placeholder="{{ text_search }}"
				/>
			</div>
		</div>
	</div>

	<div class="live-search-results" data-live-search-results hidden></div>
</div>
