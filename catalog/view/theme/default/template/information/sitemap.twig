{% set class = "col-span-12 " %}
{% if column_left and column_right %}
	{% set class = class ~ "lg:col-span-6" %}
{% elseif column_left or column_right %}
	{% set class = class ~ "lg:col-span-9" %}
{% else %}
	{% set class = class ~ "lg:col-span-12" %}
{% endif %}

<div class="container mx-auto px-2">
	{% include "default/components/breadcrumbs.twig" %}

	<h1 class="heading">{{ heading_title }}</h1>
</div>
<div class="container mx-auto grid grid-cols-1 gap-6 px-2 lg:grid-cols-12">
	{{ column_left }}
	<main class="{{ class }}">
		{{ content_top }}

		<div class="text-block">
			<ul>
				{% for category_1 in categories %}
					<li>
						<a href="{{ category_1.href }}">{{ category_1.name }}</a>
						{% if category_1.children %}
							<ul>
								{% for category_2 in category_1.children %}
									<li>
										<a href="{{ category_2.href }}">{{ category_2.name }}</a>
										{% if category_2.children %}
											<ul>
												{% for category_3 in category_2.children %}
													<li><a href="{{ category_3.href }}">{{ category_3.name }}</a></li>
												{% endfor %}
											</ul>
										{% endif %}
									</li>
								{% endfor %}
							</ul>
						{% endif %}
					</li>
				{% endfor %}
			</ul>
			<ul>
				{% if special %}
					<li><a href="{{ special }}">{{ text_special }}</a></li>
				{% endif %}
				<li>
					<a href="{{ account }}">{{ text_account }}</a>
					<ul>
						{% if edit %}<li><a href="{{ edit }}">{{ text_edit }}</a></li>{% endif %}
						{% if password %}<li><a href="{{ password }}">{{ text_password }}</a></li>{% endif %}
						{% if address %}<li><a href="{{ address }}">{{ text_address }}</a></li>{% endif %}
						{% if history %}<li><a href="{{ history }}">{{ text_history }}</a></li>{% endif %}
						{% if download %}<li><a href="{{ download }}">{{ text_download }}</a></li>{% endif %}
					</ul>
				</li>
				<li><a href="{{ cart }}">{{ text_cart }}</a></li>
				{% if checkout %}
					<li><a href="{{ checkout }}">{{ text_checkout }}</a></li>
				{% endif %}
				{% if search %}
					<li><a href="{{ search }}">{{ text_search }}</a></li>
				{% endif %}
				{% if informations or contact %}
					<li>
						{{ text_information }}
						<ul>
							{% for information in informations %}
								<li><a href="{{ information.href }}">{{ information.title }}</a></li>
							{% endfor %}
							{% if contact %}
								<li><a href="{{ contact }}">{{ text_contact }}</a></li>
							{% endif %}
						</ul>
					</li>
				{% endif %}
				{% if blog %}
					<li>
						<a href="{{ blog }}">{{ text_blog }}</a>
						{% if blog_authors %}
							<ul>
								{% for author in blog_authors %}
									<li><a href="{{ author.href }}">{{ author.name }}</a></li>
								{% endfor %}
							</ul>
						{% endif %}
					</li>
				{% endif %}
			</ul>
		</div>

		{{ content_bottom }}
	</main>
	{{ column_right }}
</div>
