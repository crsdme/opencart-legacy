{% if (languages | length) > 1 %}
	<div class="dropdown w-full flex-1" data-dropdown data-align="center" data-type="hover">
		<button class="button-secondary" type="button" data-dropdown-button>
			{{ text_language }}
			<svg aria-hidden="true" viewbox="0 0 24 24">
				<use href="/assets/icons/sprite.svg#icon-chevron-down"></use>
			</svg>
		</button>
		<div class="dropdown-menu" data-dropdown-menu>
			{% for language in languages %}
				{% if language.active %}
					<span class="dropdown-item" data-code="{{ language.code }}">{{ language.name }}</span>
				{% else %}
					<a class="dropdown-item" href="{{ language.url }}" hreflang="{{ language.code }}">{{ language.name }}</a>
				{% endif %}
			{% endfor %}
		</div>
	</div>
{% endif %}
