<div id="account-affiliate" class="container mx-auto pb-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-lg px-2 pb-8">
		<section class="flex flex-col rounded-lg bg-white p-6 shadow">
			<h1 class="mb-4 text-xl font-bold">{{ heading_title }}</h1>

			{% if error_warning %}
				<div class="relative mb-4 rounded border border-red-200 bg-red-100 px-4 py-3 text-red-500" role="alert">
					<span class="block sm:inline">{{ error_warning }}</span>
				</div>
			{% endif %}

			<form action="{{ action }}" method="post" enctype="multipart/form-data" class="flex flex-col gap-6">
				<div class="flex flex-col gap-4">
					<h2 class="text-lg font-semibold text-gray-800">{{ text_my_affiliate }}</h2>
					<div>
						<label for="input-company" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_company }}</label>
						<input type="text" name="company" value="{{ company }}" placeholder="{{ entry_company }}" id="input-company" class="input w-full" />
					</div>
					<div>
						<label for="input-website" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_website }}</label>
						<input type="text" name="website" value="{{ website }}" placeholder="{{ entry_website }}" id="input-website" class="input w-full" />
					</div>
				</div>

				<div class="flex flex-col gap-4">
					<h2 class="text-lg font-semibold text-gray-800">{{ text_payment }}</h2>
					<div>
						<label for="input-tax" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_tax }}</label>
						<input type="text" name="tax" value="{{ tax }}" placeholder="{{ entry_tax }}" id="input-tax" class="input w-full" />
					</div>
					<div>
						<span class="mb-2 block text-sm font-medium text-gray-700">{{ entry_payment }}</span>
						<div class="grid gap-2">
							<label class="flex items-center gap-2 text-sm">
								<input type="radio" name="payment" value="cheque" class="radio"{% if payment == 'cheque' %} checked="checked"{% endif %} />
								<span>{{ text_cheque }}</span>
							</label>
							<label class="flex items-center gap-2 text-sm">
								<input type="radio" name="payment" value="paypal" class="radio"{% if payment == 'paypal' %} checked="checked"{% endif %} />
								<span>{{ text_paypal }}</span>
							</label>
							<label class="flex items-center gap-2 text-sm">
								<input type="radio" name="payment" value="bank" class="radio"{% if payment == 'bank' %} checked="checked"{% endif %} />
								<span>{{ text_bank }}</span>
							</label>
						</div>
					</div>
					<div id="payment-cheque" class="payment hidden">
						<label for="input-cheque" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_cheque }}</label>
						<input type="text" name="cheque" value="{{ cheque }}" placeholder="{{ entry_cheque }}" id="input-cheque" class="input w-full" />
						{% if error_cheque %}
							<p class="form-message">{{ error_cheque }}</p>
						{% endif %}
					</div>
					<div id="payment-paypal" class="payment hidden">
						<label for="input-paypal" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_paypal }}</label>
						<input type="text" name="paypal" value="{{ paypal }}" placeholder="{{ entry_paypal }}" id="input-paypal" class="input w-full" />
						{% if error_paypal %}
							<p class="form-message">{{ error_paypal }}</p>
						{% endif %}
					</div>
					<div id="payment-bank" class="payment hidden">
						<div class="flex flex-col gap-4">
						<div>
							<label for="input-bank-name" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_bank_name }}</label>
							<input type="text" name="bank_name" value="{{ bank_name }}" placeholder="{{ entry_bank_name }}" id="input-bank-name" class="input w-full" />
						</div>
						<div>
							<label for="input-bank-branch-number" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_bank_branch_number }}</label>
							<input type="text" name="bank_branch_number" value="{{ bank_branch_number }}" placeholder="{{ entry_bank_branch_number }}" id="input-bank-branch-number" class="input w-full" />
						</div>
						<div>
							<label for="input-bank-swift-code" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_bank_swift_code }}</label>
							<input type="text" name="bank_swift_code" value="{{ bank_swift_code }}" placeholder="{{ entry_bank_swift_code }}" id="input-bank-swift-code" class="input w-full" />
						</div>
						<div>
							<label for="input-bank-account-name" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_bank_account_name }}</label>
							<input type="text" name="bank_account_name" value="{{ bank_account_name }}" placeholder="{{ entry_bank_account_name }}" id="input-bank-account-name" class="input w-full" />
							{% if error_bank_account_name %}
								<p class="form-message">{{ error_bank_account_name }}</p>
							{% endif %}
						</div>
						<div>
							<label for="input-bank-account-number" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_bank_account_number }}</label>
							<input type="text" name="bank_account_number" value="{{ bank_account_number }}" placeholder="{{ entry_bank_account_number }}" id="input-bank-account-number" class="input w-full" />
							{% if error_bank_account_number %}
								<p class="form-message">{{ error_bank_account_number }}</p>
							{% endif %}
						</div>
					</div>
					</div>
				</div>

				{% include "default/components/custom-fields.twig" with {
					custom_fields: custom_fields,
					field_values: affiliate_custom_field,
					error_custom_field: error_custom_field,
					location: "affiliate"
				} %}

				{% if text_agree %}
					<label class="flex items-start gap-2 text-sm text-gray-700">
						<input type="checkbox" name="agree" value="1" class="checkbox mt-0.5"{% if agree %} checked="checked"{% endif %} />
						<span>{{ text_agree|raw }}</span>
					</label>
				{% endif %}

				<div class="flex flex-col gap-3 sm:flex-row">
					<a href="{{ back }}" class="button-secondary w-full sm:flex-1">{{ button_back }}</a>
					<button type="submit" class="button-primary w-full sm:flex-1">{{ button_continue }}</button>
				</div>
			</form>
		</section>
	</div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
	$('input[name="payment"]').on('change', function () {
		$('.payment').addClass('hidden');
		$('#payment-' + this.value).removeClass('hidden');
	}).filter(':checked').trigger('change');

	$('button[id^="button-custom-field"]').on('click', function () {
		var element = this;
		$('#form-upload').remove();
		$('body').prepend('<form enctype="multipart/form-data" id="form-upload" class="hidden"><input type="file" name="file" /></form>');
		$('#form-upload input[name="file"]').trigger('click');
		if (typeof timer != 'undefined') {
			clearInterval(timer);
		}
		timer = setInterval(function () {
			if ($('#form-upload input[name="file"]').val() != '') {
				clearInterval(timer);
				$.ajax({
					url: 'index.php?route=tool/upload',
					type: 'post',
					dataType: 'json',
					data: new FormData($('#form-upload')[0]),
					cache: false,
					contentType: false,
					processData: false,
					success: function (json) {
						$(element).parent().find('.form-message').remove();
						if (json['error']) {
							$(element).parent().find('input[type=hidden]').after('<p class="form-message">' + json['error'] + '</p>');
						}
						if (json['success']) {
							$(element).parent().find('input[type=hidden]').val(json['code']);
						}
					}
				});
			}
		}, 500);
	});
});
</script>
