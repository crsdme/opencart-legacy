<div id="account-download" class="container mx-auto pb-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-5xl px-2 pb-8">
		<section class="flex flex-col rounded-lg bg-white p-6 shadow">
			<h1 class="mb-4 text-xl font-bold">{{ heading_title }}</h1>

			{% if downloads %}
				<div class="overflow-x-auto">
					<table class="w-full min-w-[36rem] text-left text-sm">
						<thead>
							<tr class="border-b border-neutral-200 text-neutral-500">
								<th class="py-2 pr-4 font-medium">{{ column_order_id }}</th>
								<th class="py-2 pr-4 font-medium">{{ column_name }}</th>
								<th class="py-2 pr-4 font-medium">{{ column_size }}</th>
								<th class="py-2 pr-4 font-medium">{{ column_date_added }}</th>
								<th class="py-2 font-medium"></th>
							</tr>
						</thead>
						<tbody class="divide-y divide-neutral-100">
							{% for download in downloads %}
								<tr>
									<td class="py-3 pr-4 text-gray-700">{{ download.order_id }}</td>
									<td class="py-3 pr-4 font-medium text-gray-800">{{ download.name }}</td>
									<td class="py-3 pr-4 text-gray-700">{{ download.size }}</td>
									<td class="py-3 pr-4 text-gray-700">{{ download.date_added }}</td>
									<td class="py-3 text-right">
										<a href="{{ download.href }}" class="button-primary">{{ button_download }}</a>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
					{% if results %}
						<p class="text-sm text-neutral-500">{{ results }}</p>
					{% endif %}
					{% include "default/components/pagination.twig" with { pagination: pagination_data } %}
				</div>
			{% else %}
				<p class="text-neutral-500">{{ text_empty }}</p>
			{% endif %}

			<div class="mt-6">
				<a href="{{ continue }}" class="button-secondary">{{ button_continue }}</a>
			</div>
		</section>
	</div>
</div>
