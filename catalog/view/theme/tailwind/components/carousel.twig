{% set config =
	{
		id: id | default("carousel"),
		use_autoplay: use_autoplay | default(true),
		use_controls: use_controls | default(true),
		use_dots: use_dots | default(true),
		use_loop: use_loop | default(true),
		use_picture: use_picture | default(false),
		carousel_slide_class: carousel_slide_class | default("flex w-1/5 shrink-0 justify-center px-1")
	} | merge(config | default({}))
%}

<div class="carousel" data-carousel="{{ config.id }}">
	<div class="carousel-track">
		{% for slide in slides %}
			<div class="carousel-slide {{ config.carousel_slide_class }}">
				{% if config.use_picture %}
					<picture>
						<source srcset="{{ slide.image_mobile }}" media="(max-width: 768px)" />
						<source srcset="{{ slide.image }}" media="(min-width: 769px)" />
						<img src="{{ slide.image }}" alt="{{ slide.title }}" />
					</picture>
				{% else %}
					<img src="{{ slide.image }}" alt="{{ slide.title }}" />
				{% endif %}
			</div>
		{% endfor %}
	</div>
</div>

{% if config.use_dots %}
	<div class="carousel-dots" data-carousel-dots="{{ config.id }}">
		{% for slide in slides %}
			<button type="button" class="carousel-dot bg-neutral-300" data-carousel-dot data-index="{{ loop.index0 }}" aria-label="Slide {{ loop.index }}">

			</button>
		{% endfor %}
	</div>
{% endif %}

{% if config.use_controls %}
	<div class="carousel-controls mt-4 flex justify-end gap-2">
		<button type="button" class="button-secondary icon" data-carousel-prev="{{ config.id }}">
			<svg aria-hidden="true" viewbox="0 0 24 24">
				<use href="/assets/icons/sprite.svg#icon-chevron-left"></use>
			</svg>
		</button>

		<button type="button" class="button-secondary icon" data-carousel-next="{{ config.id }}">
			<svg aria-hidden="true" viewbox="0 0 24 24">
				<use href="/assets/icons/sprite.svg#icon-chevron-right"></use>
			</svg>
		</button>
	</div>
{% endif %}

<script>
	(() => {
		const config = {{ config | json_encode | raw }};

		const carousel = document.querySelector(`[data-carousel="${config.id}"]`);

		if (!carousel) return;

		const plugins = [];

		{% if config.use_autoplay %}
			const Autoplay = window.EmblaCarouselAutoplay?.default || window.EmblaCarouselAutoplay;

			if (Autoplay) {
				plugins.push(
					Autoplay({
						delay: 3000,
						stopOnInteraction: false,
						stopOnMouseEnter: true,
					}),
				);
			}
		{% endif %}

		const embla = EmblaCarousel(carousel, { loop: config.use_loop }, plugins);

		{% if config.use_controls %}
			const prevButton = document.querySelector(`[data-carousel-prev="${config.id}"]`);
			const nextButton = document.querySelector(`[data-carousel-next="${config.id}"]`);

			prevButton?.addEventListener('click', () => embla.scrollPrev());
			nextButton?.addEventListener('click', () => embla.scrollNext());
		{% endif %}

		{% if config.use_dots %}
			const dotsWrapper = document.querySelector(`[data-carousel-dots="${config.id}"]`);
			const dots = dotsWrapper ? dotsWrapper.querySelectorAll('[data-carousel-dot]') : [];

			const syncDots = () => {
				const selectedIndex = embla.selectedScrollSnap();

				dots.forEach((dot, index) => {
					dot.classList.toggle('bg-neutral-800', index === selectedIndex);
					dot.classList.toggle('bg-neutral-300', index !== selectedIndex);
				});
			};

			embla.on('select', syncDots);
			syncDots();

			dots.forEach((dot, index) => {
				dot.addEventListener('click', () => embla.scrollTo(index));
			});
		{% endif %}
	})();
</script>
