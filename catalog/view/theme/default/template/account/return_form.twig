<div id="account-return" class="container mx-auto pb-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-lg px-2 pb-8">
		<section class="flex flex-col rounded-lg bg-white p-6 shadow">
			<h1 class="mb-2 text-xl font-bold">{{ heading_title }}</h1>
			<p class="mb-4 text-neutral-500">{{ text_description }}</p>

			{% if error_warning %}
				<div class="relative mb-4 rounded border border-red-200 bg-red-100 px-4 py-3 text-red-500" role="alert">
					<span class="block sm:inline">{{ error_warning }}</span>
				</div>
			{% endif %}

			<form action="{{ action }}" method="post" enctype="multipart/form-data" class="flex flex-col gap-6">
				<div class="flex flex-col gap-4">
					<h2 class="text-lg font-semibold text-gray-800">{{ text_order }}</h2>
					<div>
						<label for="input-firstname" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_firstname }}</label>
						<input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" id="input-firstname" class="input w-full" />
						{% if error_firstname %}
							<p class="form-message">{{ error_firstname }}</p>
						{% endif %}
					</div>
					<div>
						<label for="input-lastname" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_lastname }}</label>
						<input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" id="input-lastname" class="input w-full" />
						{% if error_lastname %}
							<p class="form-message">{{ error_lastname }}</p>
						{% endif %}
					</div>
					<div>
						<label for="input-email" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_email }}</label>
						<input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="input w-full" />
						{% if error_email %}
							<p class="form-message">{{ error_email }}</p>
						{% endif %}
					</div>
					<div>
						<label for="input-telephone" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_telephone }}</label>
						<input type="tel" name="telephone" value="{{ telephone }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="input w-full" />
						{% if error_telephone %}
							<p class="form-message">{{ error_telephone }}</p>
						{% endif %}
					</div>
					<div>
						<label for="input-order-id" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_order_id }}</label>
						<input type="text" name="order_id" value="{{ order_id }}" placeholder="{{ entry_order_id }}" id="input-order-id" class="input w-full" />
						{% if error_order_id %}
							<p class="form-message">{{ error_order_id }}</p>
						{% endif %}
					</div>
					<div>
						<label for="input-date-ordered" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_date_ordered }}</label>
						<input type="date" name="date_ordered" value="{{ date_ordered }}" id="input-date-ordered" class="input w-full" />
					</div>
				</div>

				<div class="flex flex-col gap-4">
					<h2 class="text-lg font-semibold text-gray-800">{{ text_product }}</h2>
					<div>
						<label for="input-product" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_product }}</label>
						<input type="text" name="product" value="{{ product }}" placeholder="{{ entry_product }}" id="input-product" class="input w-full" />
						<input type="hidden" name="product_id" value="{{ product_id }}" />
						{% if error_product %}
							<p class="form-message">{{ error_product }}</p>
						{% endif %}
					</div>
					<div>
						<label for="input-model" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_model }}</label>
						<input type="text" name="model" value="{{ model }}" placeholder="{{ entry_model }}" id="input-model" class="input w-full" />
						{% if error_model %}
							<p class="form-message">{{ error_model }}</p>
						{% endif %}
					</div>
					<div>
						<label for="input-quantity" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_quantity }}</label>
						<input type="text" name="quantity" value="{{ quantity }}" placeholder="{{ entry_quantity }}" id="input-quantity" class="input w-full" />
					</div>
					<div>
						<span class="mb-2 block text-sm font-medium text-gray-700">{{ entry_reason }}</span>
						<div class="grid gap-2">
							{% for return_reason in return_reasons %}
								<label class="flex items-center gap-2 text-sm">
									<input type="radio" name="return_reason_id" value="{{ return_reason.return_reason_id }}" class="radio"{% if return_reason.return_reason_id == return_reason_id %} checked="checked"{% endif %} />
									<span>{{ return_reason.name }}</span>
								</label>
							{% endfor %}
						</div>
						{% if error_reason %}
							<p class="form-message">{{ error_reason }}</p>
						{% endif %}
					</div>
					<div>
						<span class="mb-2 block text-sm font-medium text-gray-700">{{ entry_opened }}</span>
						<div class="grid gap-2">
							<label class="flex items-center gap-2 text-sm">
								<input type="radio" name="opened" value="1" class="radio"{% if opened %} checked="checked"{% endif %} />
								<span>{{ text_yes }}</span>
							</label>
							<label class="flex items-center gap-2 text-sm">
								<input type="radio" name="opened" value="0" class="radio"{% if not opened %} checked="checked"{% endif %} />
								<span>{{ text_no }}</span>
							</label>
						</div>
					</div>
					<div>
						<label for="input-comment" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_fault_detail }}</label>
						<textarea name="comment" id="input-comment" rows="6" placeholder="{{ entry_fault_detail }}" class="input min-h-28 w-full resize-y">{{ comment }}</textarea>
					</div>
				</div>

				{{ captcha }}

				{% if text_agree %}
					<label class="flex items-start gap-2 text-sm text-gray-700">
						<input type="checkbox" name="agree" value="1" class="checkbox mt-0.5"{% if agree %} checked="checked"{% endif %} />
						<span>{{ text_agree|raw }}</span>
					</label>
				{% endif %}

				<div class="flex flex-col gap-3 sm:flex-row">
					<a href="{{ back }}" class="button-secondary w-full sm:flex-1">{{ button_back }}</a>
					<button type="submit" class="button-primary w-full sm:flex-1">{{ button_continue }}</button>
				</div>
			</form>
		</section>
	</div>
</div>
