{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right">
				<button type="submit" form="form-shipping" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
				<a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="container-fluid">
		{% if error_warning %}
			<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		{% if success %}
			<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
			</div>
			<div class="panel-body">
				<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping" class="form-horizontal">
					<ul class="nav nav-tabs">
						<li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
						<li><a href="#tab-database" data-toggle="tab">{{ tab_database }}</a></li>
					</ul>
					<div class="tab-content">
						<div class="tab-pane active" id="tab-general">
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
								<div class="col-sm-10">
									<select name="shipping_novaposhta_status" id="input-status" class="form-control">
										<option value="1"{% if status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
										<option value="0"{% if not status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
									</select>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
								<div class="col-sm-10">
									<input type="text" name="shipping_novaposhta_sort_order" value="{{ sort_order }}" id="input-sort-order" class="form-control" />
								</div>
							</div>
							<div class="form-group required">
								<label class="col-sm-2 control-label" for="input-key-api"><span data-toggle="tooltip" title="{{ help_key_api }}">{{ entry_key_api }}</span></label>
								<div class="col-sm-10">
									<input type="text" name="shipping_novaposhta[key_api]" value="{{ key_api }}" id="input-key-api" class="form-control" />
									{% if error_key_api %}
										<div class="text-danger">{{ error_key_api }}</div>
									{% endif %}
								</div>
							</div>
							{% for method in methods %}
								<legend>{{ method.label }}</legend>
								<div class="form-group">
									<label class="col-sm-2 control-label">{{ entry_method_status }}</label>
									<div class="col-sm-10">
										<select name="shipping_novaposhta[methods][{{ method.code }}][status]" class="form-control">
											<option value="1"{% if method.status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
											<option value="0"{% if not method.status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
										</select>
									</div>
								</div>
								<div class="form-group">
									<label class="col-sm-2 control-label">{{ entry_name }}</label>
									<div class="col-sm-10">
										{% for language in languages %}
											<div class="input-group" style="margin-bottom: 5px;">
												<span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
												<input type="text" name="shipping_novaposhta[methods][{{ method.code }}][name][{{ language.language_id }}]" value="{{ method.name[language.language_id] is defined ? method.name[language.language_id] }}" placeholder="{{ method.label }}" class="form-control" />
											</div>
										{% endfor %}
									</div>
								</div>
								<div class="form-group">
									<label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_cost }}">{{ entry_cost }}</span></label>
									<div class="col-sm-10">
										<input type="text" name="shipping_novaposhta[methods][{{ method.code }}][cost]" value="{{ method.cost }}" class="form-control" />
									</div>
								</div>
								<div class="form-group">
									<label class="col-sm-2 control-label">{{ entry_geo_zone }}</label>
									<div class="col-sm-10">
										<select name="shipping_novaposhta[methods][{{ method.code }}][geo_zone_id]" class="form-control">
											<option value="0">{{ text_all_zones }}</option>
											{% for geo_zone in geo_zones %}
												<option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == method.geo_zone_id %} selected="selected"{% endif %}>{{ geo_zone.name }}</option>
											{% endfor %}
										</select>
									</div>
								</div>
								<div class="form-group">
									<label class="col-sm-2 control-label">{{ entry_tax_class }}</label>
									<div class="col-sm-10">
										<select name="shipping_novaposhta[methods][{{ method.code }}][tax_class_id]" class="form-control">
											<option value="0">{{ text_none }}</option>
											{% for tax_class in tax_classes %}
												<option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == method.tax_class_id %} selected="selected"{% endif %}>{{ tax_class.title }}</option>
											{% endfor %}
										</select>
									</div>
								</div>
							{% endfor %}
						</div>
						<div class="tab-pane" id="tab-database">
							<div class="table-responsive">
								<table class="table table-bordered table-hover">
									<thead>
										<tr>
											<th>{{ column_type }}</th>
											<th class="text-center">{{ column_date }}</th>
											<th class="text-center">{{ column_amount }}</th>
											<th>{{ column_description }}</th>
											<th class="text-center">{{ column_action }}</th>
										</tr>
									</thead>
									<tbody>
										{% for row in database %}
											<tr>
												<td>{{ row.label }}</td>
												<td class="text-center" data-updated="{{ row.type }}">{{ row.updated_at }}</td>
												<td class="text-center" data-amount="{{ row.type }}">{{ row.amount }}</td>
												<td>{{ row.help }}</td>
												<td class="text-center">
													<button type="button" class="btn btn-success" data-sync="{{ row.type }}"><i class="fa fa-refresh"></i> {{ button_update }}</button>
												</td>
											</tr>
										{% endfor %}
										<tr>
											<td>{{ entry_settlements }}</td>
											<td class="text-center"><span class="label label-success">{{ text_online }}</span></td>
											<td></td>
											<td>{{ help_settlements }}</td>
											<td class="text-center">
												<input type="hidden" name="shipping_novaposhta[settlements]" value="0" />
												<input type="checkbox" name="shipping_novaposhta[settlements]" value="1"{% if settlements %} checked="checked"{% endif %} />
											</td>
										</tr>
										<tr>
											<td>{{ entry_streets }}</td>
											<td class="text-center"><span class="label label-success">{{ text_online }}</span></td>
											<td></td>
											<td>{{ help_streets }}</td>
											<td class="text-center">
												<input type="hidden" name="shipping_novaposhta[streets]" value="0" />
												<input type="checkbox" name="shipping_novaposhta[streets]" value="1"{% if streets %} checked="checked"{% endif %} />
											</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
<script>
$('[data-sync]').on('click', function () {
	var type = $(this).data('sync');
	var button = $(this);
	button.prop('disabled', true).find('i').addClass('fa-spin');
	$.ajax({
		url: '{{ sync }}'.replace(/&amp;/g, '&'),
		type: 'get',
		data: { type: type },
		dataType: 'json',
		complete: function () {
			button.prop('disabled', false).find('i').removeClass('fa-spin');
		},
		success: function (json) {
			$('.alert-dismissible').remove();
			if (json.error) {
				$('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json.error + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
				return;
			}
			$('[data-amount="' + type + '"]').text(json.amount);
			$('[data-updated="' + type + '"]').text(json.updated_at);
			$('#content > .container-fluid').prepend('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json.success + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
		}
	});
});
</script>
{{ footer }}
