{% if options %}
	<div class="flex flex-col gap-4">
		<h2 class="heading-5 mb-0">{{ text_option }}</h2>

		{% for option in options %}
			{% if option.type == "select" %}
				<div class="form-item{% if option.required %} required{% endif %}">
					<label class="form-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
					<select name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" class="input">
						<option value="">
							{{ text_select }}
						</option>
						{% for option_value in option.product_option_value %}
							<option value="{{ option_value.product_option_value_id }}">
								{{ option_value.name }}
								{% if option_value.price %}
									({{ option_value.price_prefix }}{{ option_value.price }})
								{% endif %}
							</option>
						{% endfor %}
					</select>
				</div>
			{% endif %}

			{% if option.type == "radio" %}
				<div class="form-item{% if option.required %} required{% endif %}">
					<span class="form-label">{{ option.name }}</span>
					<div class="grid gap-2" id="input-option{{ option.product_option_id }}">
						{% for option_value in option.product_option_value %}
							<label class="flex items-center gap-2 text-sm">
								<input
									class="radio"
									type="radio"
									name="option[{{ option.product_option_id }}]"
									value="{{ option_value.product_option_value_id }}"
								/>
								{% if option_value.image %}
									<img src="{{ option_value.image }}" alt="{{ option_value.name }}" class="h-8 w-8 rounded-md object-contain" />
								{% endif %}
								<span>
									{{ option_value.name }}
									{% if option_value.price %}
										({{ option_value.price_prefix }}{{ option_value.price }})
									{% endif %}
								</span>
							</label>
						{% endfor %}
					</div>
				</div>
			{% endif %}

			{% if option.type == "checkbox" %}
				<div class="form-item{% if option.required %} required{% endif %}">
					<span class="form-label">{{ option.name }}</span>
					<div class="grid gap-2" id="input-option{{ option.product_option_id }}">
						{% for option_value in option.product_option_value %}
							<label class="flex items-center gap-2 text-sm">
								<input
									class="checkbox"
									type="checkbox"
									name="option[{{ option.product_option_id }}][]"
									value="{{ option_value.product_option_value_id }}"
								/>
								{% if option_value.image %}
									<img src="{{ option_value.image }}" alt="{{ option_value.name }}" class="h-8 w-8 rounded-md object-contain" />
								{% endif %}
								<span>
									{{ option_value.name }}
									{% if option_value.price %}
										({{ option_value.price_prefix }}{{ option_value.price }})
									{% endif %}
								</span>
							</label>
						{% endfor %}
					</div>
				</div>
			{% endif %}

			{% if option.type == "text" %}
				<div class="form-item{% if option.required %} required{% endif %}">
					<label class="form-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
					<input
						class="input"
						type="text"
						name="option[{{ option.product_option_id }}]"
						value="{{ option.value }}"
						placeholder="{{ option.name }}"
						id="input-option{{ option.product_option_id }}"
					/>
				</div>
			{% endif %}

			{% if option.type == "textarea" %}
				<div class="form-item{% if option.required %} required{% endif %}">
					<label class="form-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
					<textarea
						class="input min-h-28 resize-y"
						name="option[{{ option.product_option_id }}]"
						rows="5"
						placeholder="{{ option.name }}"
						id="input-option{{ option.product_option_id }}"
					>
						{{ option.value }}
					</textarea>
				</div>
			{% endif %}

			{% if option.type == "file" %}
				<div class="form-item{% if option.required %} required{% endif %}">
					<span class="form-label">{{ option.name }}</span>
					<button type="button" class="button-secondary" data-option-upload="{{ option.product_option_id }}">{{ button_upload }}</button>
					<input type="hidden" name="option[{{ option.product_option_id }}]" value="" id="input-option{{ option.product_option_id }}" />
				</div>
			{% endif %}

			{% if option.type == "date" %}
				<div class="form-item{% if option.required %} required{% endif %}">
					<label class="form-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
					<input
						class="input"
						type="date"
						name="option[{{ option.product_option_id }}]"
						value="{{ option.value }}"
						id="input-option{{ option.product_option_id }}"
					/>
				</div>
			{% endif %}

			{% if option.type == "datetime" %}
				<div class="form-item{% if option.required %} required{% endif %}">
					<label class="form-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
					<input
						class="input"
						type="datetime-local"
						name="option[{{ option.product_option_id }}]"
						value="{{ option.value }}"
						id="input-option{{ option.product_option_id }}"
					/>
				</div>
			{% endif %}

			{% if option.type == "time" %}
				<div class="form-item{% if option.required %} required{% endif %}">
					<label class="form-label" for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
					<input
						class="input"
						type="time"
						name="option[{{ option.product_option_id }}]"
						value="{{ option.value }}"
						id="input-option{{ option.product_option_id }}"
					/>
				</div>
			{% endif %}
		{% endfor %}
	</div>
{% endif %}
