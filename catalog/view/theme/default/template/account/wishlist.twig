{% set class = "col-span-12 " %}
{% if column_left and column_right %}
	{% set class = class ~ "lg:col-span-6" %}
{% elseif column_left or column_right %}
	{% set class = class ~ "lg:col-span-9" %}
{% else %}
	{% set class = class ~ "lg:col-span-12" %}
{% endif %}

<div id="account-wishlist" class="container mx-auto px-2">
	{% include "default/components/breadcrumbs.twig" %}
</div>

<div class="container mx-auto grid grid-cols-1 gap-6 px-2 pb-10 lg:grid-cols-12">
	{{ column_left }}
	<main class="{{ class }}">
		<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
			<h1 class="heading mb-0">{{ heading_title }}</h1>
		</div>

		{{ content_top }}

		{% if success %}
			<div class="relative mb-4 rounded border border-green-200 bg-green-100 px-4 py-3 text-green-600" role="alert">
				<span class="block sm:inline">{{ success }}</span>
			</div>
		{% endif %}

		{% if products %}
			<section class="grid grid-cols-2 gap-2 sm:gap-4 xl:grid-cols-3" aria-label="{{ heading_title }}">
				{% for product in products %}
					{% include "default/components/product-card.twig" with {
						product: product
					} %}
				{% endfor %}
			</section>
		{% else %}
			<section class="mx-auto my-8 w-full md:w-1/2" aria-label="{{ text_empty }}">
				<p class="text">
					{{ text_empty }}
				</p>
				<a href="{{ continue }}" class="button-primary mt-4">{{ button_continue }}</a>
			</section>
		{% endif %}

		{{ content_bottom }}
	</main>
	{{ column_right }}
</div>
