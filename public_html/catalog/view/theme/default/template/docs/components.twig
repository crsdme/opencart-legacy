{% include "default/template/docs/copy.twig" with { section: sections.toast } %}

{% include "default/template/docs/section.twig" with { section: sections.breadcrumbs } %}
	{% include "default/components/breadcrumbs.twig" with {
		breadcrumbs: breadcrumbs
	} %}
{% include "default/template/docs/copy.twig" with { section: sections.breadcrumbs } %}

{% include "default/template/docs/section.twig" with { section: sections['text-block'] } %}
	{% include "default/components/text-block.twig" %}
{% include "default/template/docs/copy.twig" with { section: sections['text-block'] } %}

{% include "default/template/docs/section.twig" with { section: sections.accordion } %}
	<div class="max-w-2xl">
		{% include "default/components/accordion.twig" with {
			items: [
				{
					title: "Is this an accordion?",
					content: "Yes. Native details/summary, keyboard accessible, no JavaScript."
				},
				{
					title: "Can more than one item stay open?",
					content: "Yes. FAQ pages work better when users can compare answers."
				}
			]
		} %}
	</div>
{% include "default/template/docs/copy.twig" with { section: sections.accordion } %}

{% include "default/template/docs/section.twig" with { section: sections.pagination } %}
	<div class="flex flex-col gap-6">
		{% include "default/components/pagination.twig" with {
			pagination: {
				total: 500,
				page: 1,
				limit: 10,
				text_next: "Next",
				text_prev: "Previous",
				url: pagination_url
			}
		} %}
		{% include "default/components/pagination.twig" with {
			pagination: {
				total: 500,
				page: 25,
				limit: 10,
				text_next: "Next",
				text_prev: "Previous",
				url: pagination_url
			}
		} %}
		{% include "default/components/pagination.twig" with {
			pagination: {
				total: 500,
				page: 50,
				limit: 10,
				text_next: "Next",
				text_prev: "Previous",
				url: pagination_url
			}
		} %}
	</div>
{% include "default/template/docs/copy.twig" with { section: sections.pagination } %}

{% include "default/template/docs/section.twig" with { section: sections.carousel } %}
	{% if carousel_slides %}
		{% include "default/components/carousel.twig" with {
			slides: carousel_slides,
			config: {
				id: "components-carousel",
				use_controls: true,
				use_controls_mobile: false,
				use_picture: true,
				slides: 1,
				slides_mobile: 1
			}
		} %}
	{% else %}
		<p class="docs-muted">No banner slides. Create banner ID 8 in Design → Banners.</p>
	{% endif %}
{% include "default/template/docs/copy.twig" with { section: sections.carousel } %}

{% include "default/template/docs/section.twig" with { section: sections['product-card'] } %}
	{% if products %}
		<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
			{% for product in products %}
				{% include "default/components/product-card.twig" with {
					product: product
				} %}
			{% endfor %}
		</div>
	{% else %}
		<p class="docs-muted">No products in the catalog yet.</p>
	{% endif %}
{% include "default/template/docs/copy.twig" with { section: sections['product-card'] } %}

{% include "default/template/docs/section.twig" with { section: sections['article-card'] } %}
	{% if articles %}
		<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
			{% for article in articles %}
				{% include "default/components/article-card.twig" with {
					article: article,
					button_more: button_more
				} %}
			{% endfor %}
		</div>
	{% else %}
		<p class="docs-muted">No blog articles yet.</p>
	{% endif %}
{% include "default/template/docs/copy.twig" with { section: sections['article-card'] } %}

{% include "default/template/docs/section.twig" with { section: sections['article-slider'] } %}
	{% if articles %}
		{% include "default/components/article-slider.twig" with {
			articles: articles,
			heading_id: "components-articles",
			heading_title: "Latest articles",
			slider: true,
			button_more: button_more,
			slider_config: {
				id: "components-articles",
				use_controls: true,
				use_controls_mobile: true,
				use_autoplay: false,
				use_autoplay_mobile: false,
				use_loop: true,
				use_loop_mobile: true,
				gap: 16,
				gap_mobile: 8,
				breakpoint: 1024
			}
		} %}
	{% else %}
		<p class="docs-muted">No blog articles yet.</p>
	{% endif %}
{% include "default/template/docs/copy.twig" with { section: sections['article-slider'] } %}

{% include "default/template/docs/section.twig" with { section: sections['product-gallery'] } %}
	<div class="max-w-lg">
		{% if gallery %}
			{% include "default/components/product-gallery.twig" with {
				gallery: gallery,
				heading_title: heading_title
			} %}
		{% else %}
			<p class="docs-muted">No product images to preview.</p>
		{% endif %}
	</div>
{% include "default/template/docs/copy.twig" with { section: sections['product-gallery'] } %}

{% include "default/template/docs/section.twig" with { section: sections['product-options'] } %}
	<div class="max-w-lg">
		{% include "default/components/product-options.twig" with {
			options: options,
			text_option: text_option,
			text_select: text_select,
			button_upload: button_upload
		} %}
	</div>
{% include "default/template/docs/copy.twig" with { section: sections['product-options'] } %}

{% include "default/template/docs/section.twig" with { section: sections['product-recurrings'] } %}
	<div class="max-w-lg">
		{% include "default/components/product-recurrings.twig" with {
			recurrings: recurrings,
			text_payment_recurring: text_payment_recurring,
			text_select: text_select
		} %}
	</div>
{% include "default/template/docs/copy.twig" with { section: sections['product-recurrings'] } %}

{% include "default/template/docs/section.twig" with { section: sections.faq } %}
	<div class="max-w-2xl">
		{% include "default/components/faq.twig" with {
			faq: faq
		} %}
	</div>
{% include "default/template/docs/copy.twig" with { section: sections.faq } %}
