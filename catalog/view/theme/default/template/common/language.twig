{% if (languages | length) > 1 %}
	<div class="flex flex-wrap gap-2">
		{% for language in languages %}
			{% if language.active %}
				<span class="button-secondary" data-size="small" data-active="true">{{ language.name }}</span>
			{% else %}
				<a class="button-secondary" data-size="small" href="{{ language.url }}" hreflang="{{ language.code }}">{{ language.name }}</a>
			{% endif %}
		{% endfor %}
	</div>
{% endif %}
