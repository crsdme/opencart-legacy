<div id="account-login" class="container mx-auto py-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-lg px-2">
		<section class="flex flex-col rounded-lg bg-white p-6 shadow">
			{% if phone_auth %}
				<h2 class="mb-2 text-xl font-bold">{{ text_returning_customer }}</h2>
				<p class="text-neutral-500">
					{{ text_phone_hint }}
				</p>
				<form
					action="{{ action }}"
					method="post"
					enctype="multipart/form-data"
					class="mt-4 flex flex-col gap-4"
					data-phone-login
					data-send-url="{{ send_code }}"
					data-phone-prefix="{{ phone_prefix }}"
				>
					<div>
						<label for="input-telephone" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_telephone }}</label>
						<input
							type="tel"
							value="{{ telephone }}"
							placeholder="{{ entry_telephone }}"
							id="input-telephone"
							autocomplete="tel"
							inputmode="tel"
							class="input w-full"
							data-phone-input
						/>
						<input type="hidden" name="telephone" value="{{ telephone }}" />
					</div>
					<div data-phone-login-code{% if not code %} hidden{% endif %}>
						<label for="input-code" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_code }}</label>
						<input
							type="text"
							name="code"
							value="{{ code }}"
							placeholder="{{ entry_code }}"
							id="input-code"
							inputmode="numeric"
							autocomplete="one-time-code"
							class="input w-full"
						/>
					</div>

					{% if success %}
						<div class="relative rounded border border-green-200 bg-green-100 px-4 py-3 text-green-500" role="alert">
							<span class="block sm:inline">{{ success }}</span>
						</div>
					{% endif %}
					{% if error_warning %}
						<div class="relative rounded border border-red-200 bg-red-100 px-4 py-3 text-red-500" role="alert">
							<span class="block sm:inline">{{ error_warning }}</span>
						</div>
					{% endif %}
					<div class="relative rounded border border-red-200 bg-red-100 px-4 py-3 text-red-500" role="alert" data-phone-login-error hidden>
						<span class="block sm:inline"></span>
					</div>
					<div class="relative rounded border border-green-200 bg-green-100 px-4 py-3 text-green-500" role="alert" data-phone-login-success hidden>
						<span class="block sm:inline"></span>
					</div>

					<div class="flex flex-col gap-3 sm:flex-row">
						<button type="button" class="button-secondary w-full sm:flex-1" data-phone-login-send data-label="{{ button_send_code }}" data-resend="{{ text_send_code_again }}">
							{{ button_send_code }}
						</button>
						<button type="submit" class="button-primary w-full sm:flex-1" data-phone-login-submit{% if not code %} hidden{% endif %}>
							{{ button_login }}
						</button>
					</div>
					{% if redirect %}
						<input type="hidden" name="redirect" value="{{ redirect }}" />
					{% endif %}
				</form>
			{% else %}
				<h2 class="mb-2 text-xl font-bold">{{ text_returning_customer }}</h2>
				<p class="text-neutral-500">
					{{ text_i_am_returning_customer }}
				</p>
				<form action="{{ action }}" method="post" enctype="multipart/form-data" class="mt-4 flex flex-col gap-4">
					<div>
						<label for="input-email" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_email }}</label>
						<input
							type="text"
							name="email"
							value="{{ email }}"
							placeholder="{{ entry_email }}"
							id="input-email"
							autocomplete="email"
							class="input w-full"
						/>
					</div>
					<div>
						<label for="input-password" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_password }}</label>
						<input
							type="password"
							name="password"
							value="{{ password }}"
							placeholder="{{ entry_password }}"
							id="input-password"
							autocomplete="current-password"
							class="input w-full"
						/>
						<div class="mt-1 flex justify-end">
							<a href="{{ forgotten }}" class="text-primary text-sm hover:underline">{{ text_forgotten }}</a>
						</div>
					</div>

					{% if success %}
						<div class="relative rounded border border-green-200 bg-green-100 px-4 py-3 text-green-500" role="alert">
							<span class="block sm:inline">{{ success }}</span>
						</div>
					{% endif %}
					{% if error_warning %}
						<div class="relative rounded border border-red-200 bg-red-100 px-4 py-3 text-red-500" role="alert">
							<span class="block sm:inline">{{ error_warning }}</span>
						</div>
					{% endif %}

					<div class="flex flex-col gap-3 sm:flex-row">
						<a href="{{ register }}" class="button-secondary w-full sm:flex-1">{{ text_register }}</a>
						<button type="submit" class="button-primary w-full sm:flex-1">{{ button_login }}</button>
					</div>
					{% if redirect %}
						<input type="hidden" name="redirect" value="{{ redirect }}" />
					{% endif %}
				</form>
			{% endif %}
		</section>
	</div>
</div>
