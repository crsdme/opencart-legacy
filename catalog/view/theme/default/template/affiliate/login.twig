<div id="affiliate-login" class="container mx-auto py-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-3xl px-2">
		<section class="flex flex-col gap-8">
			{% if success %}
				<div class="rounded border border-green-200 bg-green-100 px-4 py-3 text-green-500" role="alert">
					{{ success }}
				</div>
			{% endif %}
			{% if error_warning %}
				<div class="rounded border border-red-200 bg-red-100 px-4 py-3 text-red-500" role="alert">
					{{ error_warning }}
				</div>
			{% endif %}

			<p class="text-gray-600">{{ text_description }}</p>

			<div class="grid gap-6 md:grid-cols-2">
				<div class="flex flex-col rounded-lg bg-white p-6 shadow">
					<h2 class="mb-2 text-xl font-bold">{{ text_new_affiliate }}</h2>
					<p class="mb-4 text-neutral-500">{{ text_register_account }}</p>
					<a href="{{ register }}" class="button-primary w-full sm:w-auto sm:self-start">{{ button_continue }}</a>
				</div>

				<div class="flex flex-col rounded-lg bg-white p-6 shadow">
					<h2 class="mb-2 text-xl font-bold">{{ text_returning_affiliate }}</h2>
					<p class="text-neutral-500">{{ text_i_am_returning_affiliate }}</p>
					<form action="{{ action }}" method="post" enctype="multipart/form-data" class="mt-4 flex flex-col gap-4">
						<div>
							<label for="input-email" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_email }}</label>
							<input
								type="text"
								name="email"
								value="{{ email }}"
								placeholder="{{ entry_email }}"
								id="input-email"
								autocomplete="email"
								class="input w-full"
							/>
						</div>
						<div>
							<label for="input-password" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_password }}</label>
							<input
								type="password"
								name="password"
								value="{{ password }}"
								placeholder="{{ entry_password }}"
								id="input-password"
								autocomplete="current-password"
								class="input w-full"
							/>
							<div class="mt-1 flex justify-end">
								<a href="{{ forgotten }}" class="text-primary text-sm hover:underline">{{ text_forgotten }}</a>
							</div>
						</div>
						<button type="submit" class="button-primary w-full">{{ button_login }}</button>
						{% if redirect %}
							<input type="hidden" name="redirect" value="{{ redirect }}" />
						{% endif %}
					</form>
				</div>
			</div>
		</section>
	</div>
</div>
