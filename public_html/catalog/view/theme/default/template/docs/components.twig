{% include "default/template/docs/section.twig" with { section: sections.rating } %}
	<div class="flex flex-col gap-6">
		<div>
			<p class="text-muted mb-2">Read-only</p>
			{% include "default/components/rating.twig" with { rating: 4 } %}
		</div>
		<div>
			<p class="text-muted mb-2">Interactive</p>
			{% include "default/components/rating.twig" with {
				interactive: true,
				entry_rating: "Your rating"
			} %}
		</div>
	</div>
{% include "default/template/docs/copy.twig" with { section: sections.rating } %}

{% include "default/template/docs/section.twig" with { section: sections['custom-fields'] } %}
