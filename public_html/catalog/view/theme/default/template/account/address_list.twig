<div id="account-address" class="container mx-auto pb-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-3xl px-2 pb-8">
		{% if success %}
			<div class="relative mb-4 rounded border border-green-200 bg-green-100 px-4 py-3 text-green-500" role="alert">
				<span class="block sm:inline">{{ success }}</span>
			</div>
		{% endif %}
		{% if error_warning %}
			<div class="relative mb-4 rounded border border-red-200 bg-red-100 px-4 py-3 text-red-500" role="alert">
				<span class="block sm:inline">{{ error_warning }}</span>
			</div>
		{% endif %}

		<section class="flex flex-col rounded-lg bg-white p-6 shadow">
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
				<h1 class="text-xl font-bold">{{ text_address_book }}</h1>
				<a href="{{ add }}" class="button-primary">{{ button_new_address }}</a>
			</div>

			{% if addresses %}
				<ul class="divide-y divide-neutral-100">
					{% for result in addresses %}
						<li class="flex flex-col gap-3 py-4 sm:flex-row sm:items-start sm:justify-between">
							<div class="text-sm leading-6 text-gray-700">{{ result.address|raw }}</div>
							<div class="flex flex-wrap gap-2">
								<a href="{{ result.update }}" class="button-secondary">{{ button_edit }}</a>
								<a href="{{ result.delete }}" class="button-destructive" onclick="return confirm('{{ text_confirm }}');">{{ button_delete }}</a>
							</div>
						</li>
					{% endfor %}
				</ul>
			{% else %}
				<p class="text-neutral-500">{{ text_empty }}</p>
			{% endif %}

			<div class="mt-6">
				<a href="{{ back }}" class="button-secondary">{{ button_back }}</a>
			</div>
		</section>
	</div>
</div>
