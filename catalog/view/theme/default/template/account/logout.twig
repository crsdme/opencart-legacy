<div id="account-logout" class="container mx-auto px-2">
	{% include "default/components/breadcrumbs.twig" %}

	<div class="mx-auto max-w-lg px-2 pb-8">
		<section class="flex flex-col rounded-lg bg-white p-6 shadow">
			<h1 class="mb-2 text-xl font-bold">{{ heading_title }}</h1>
			<div class="text-block mb-0">
				{{ text_message | raw }}
			</div>
			<div class="mt-6 flex flex-col gap-3 sm:flex-row">
				<a href="{{ continue }}" class="button-secondary w-full sm:flex-1">{{ button_continue }}</a>
				<a href="{{ login }}" class="button-primary w-full sm:flex-1">{{ button_login }}</a>
			</div>
		</section>
	</div>
</div>
