{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<h1>{{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="container-fluid">
		{% if error_warning %}
			<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
		{% endif %}
		{% if success %}
			<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
		{% endif %}
		{% include 'extension/import_export/tabs.twig' %}
		<div class="panel panel-default">
			<div class="panel-heading"><h3 class="panel-title"><i class="fa fa-upload"></i> {{ text_import }}</h3></div>
			<div class="panel-body">
				<p class="help-block">{{ help_import }}</p>
				<form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
					<div class="form-group">
						<label class="col-sm-2 control-label">{{ entry_entity }}</label>
						<div class="col-sm-10">
							<select name="entity" class="form-control">
								{% for code, name in entities %}
									<option value="{{ code }}">{{ name }}</option>
								{% endfor %}
							</select>
							<p class="help-block">{{ text_csv_hint }}</p>
						</div>
					</div>
					<div class="form-group">
						<label class="col-sm-2 control-label">{{ entry_file }}</label>
						<div class="col-sm-10">
							<input type="file" name="import" accept=".csv,.json,text/csv,application/json" />
						</div>
					</div>
					<div class="form-group">
						<label class="col-sm-2 control-label">{{ text_or }}</label>
						<div class="col-sm-10">
							<textarea name="import_text" rows="8" class="form-control" placeholder='{"version":1,"entity":"product","items":[]}'></textarea>
						</div>
					</div>
					<div class="form-group">
						<div class="col-sm-offset-2 col-sm-10">
							<button type="submit" class="btn btn-default">{{ button_preview }}</button>
						</div>
					</div>
					{% if preview %}
						<div class="alert alert-info">
							{{ text_create }}: {{ preview.counts.create }} |
							{{ text_update }}: {{ preview.counts.update }} |
							{{ text_skip }}: {{ preview.counts.skip }} |
							{{ text_error }}: {{ preview.counts.error }} |
							{{ text_total }}: {{ preview.total }}
						</div>
						{% if preview.sample %}
							<div class="table-responsive">
								<table class="table table-bordered">
									<thead>
										<tr>
											<td>{{ column_row }}</td>
											<td>{{ column_entity }}</td>
											<td>{{ column_identity }}</td>
											<td>{{ column_action }}</td>
											<td>{{ column_message }}</td>
										</tr>
									</thead>
									<tbody>
										{% for row in preview.sample %}
											<tr class="{% if row.action == 'error' %}danger{% elseif row.action == 'skip' %}warning{% elseif row.action == 'create' %}success{% endif %}">
												<td>{{ row.row }}</td>
												<td>{{ row.entity }}</td>
												<td>{{ row.identity }}</td>
												<td>{{ row.action }}</td>
												<td>{{ row.error }}</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>
						{% endif %}
						{% if can_modify and preview.counts.error == 0 %}
							<button type="submit" name="confirm" value="1" class="btn btn-primary">{{ button_import }}</button>
						{% elseif can_modify and preview.total %}
							<button type="submit" name="confirm" value="1" class="btn btn-warning">{{ button_import }}</button>
						{% endif %}
					{% endif %}
				</form>
			</div>
		</div>
	</div>
</div>
{{ footer }}
