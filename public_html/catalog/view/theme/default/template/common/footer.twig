<footer class="footer">
	<div class="footer-inner">
		<div class="footer-grid">
			<div class="footer-brand">
				<a class="footer-logo" href="{{ home }}" aria-label="{{ text_home }}">
					<svg aria-hidden="true" width="100" height="31">
						<use href="/assets/icons/sprite.svg#logo"></use>
					</svg>
				</a>
				{% if telephone or email or address %}
					<div class="footer-contact">
						{% if telephone %}
							<a class="footer-link" href="{{ telephone_href }}">{{ telephone }}</a>
						{% endif %}
						{% if email %}
							<a class="footer-link" href="{{ email_href }}">{{ email }}</a>
						{% endif %}
						{% if address %}
							<p class="footer-address">
								{{ address }}
							</p>
						{% endif %}
					</div>
				{% endif %}
			</div>

			{% for column in columns %}
				<nav class="footer-nav" aria-label="{{ column.title }}">
					<p class="footer-title">{{ column.title }}</p>
					<ul class="footer-list">
						{% for link in column.links %}
							<li><a href="{{ link.href }}" class="footer-link">{{ link.name }}</a></li>
						{% endfor %}
					</ul>
				</nav>
			{% endfor %}
		</div>

		<div class="footer-bottom">
			<p>
				{{ powered }}
			</p>
		</div>
	</div>
</footer>

<div class="modal flex max-h-[80vh] w-[calc(100%-2rem)] flex-col gap-4 p-4 md:p-6" id="agree-modal">
	<div class="modal-header">
		<p class="heading" data-agree-title></p>
		<button type="button" class="button-secondary" data-type="icon" data-modal-close aria-label="×">
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<use href="/assets/icons/sprite.svg#icon-close"></use>
			</svg>
		</button>
	</div>
	<div class="min-h-0 flex-1 overflow-y-auto text-sm" data-agree-body></div>
</div>

{% if rendered_footer_styles %}
	{{ rendered_footer_styles | raw }}
{% else %}
	{% for style in styles %}
		<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
	{% endfor %}
{% endif %}
{% if rendered_footer_scripts %}
	{{ rendered_footer_scripts | raw }}
{% else %}
	{% for script in scripts %}
		<script src="{{ script }}" type="text/javascript"></script>
	{% endfor %}
{% endif %}
