<div id="account-reward" class="container mx-auto pb-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-5xl px-2 pb-8">
		<section class="flex flex-col rounded-lg bg-white p-6 shadow">
			<h1 class="mb-2 text-xl font-bold">{{ heading_title }}</h1>
			<p class="mb-6 text-neutral-500">{{ text_total }} <span class="font-semibold text-gray-800">{{ total }}</span></p>

			<div class="overflow-x-auto">
				<table class="w-full min-w-[28rem] text-left text-sm">
					<thead>
						<tr class="border-b border-neutral-200 text-neutral-500">
							<th class="py-2 pr-4 font-medium">{{ column_date_added }}</th>
							<th class="py-2 pr-4 font-medium">{{ column_description }}</th>
							<th class="py-2 text-right font-medium">{{ column_points }}</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-neutral-100">
						{% if rewards %}
							{% for reward in rewards %}
								<tr>
									<td class="py-3 pr-4 text-gray-700">{{ reward.date_added }}</td>
									<td class="py-3 pr-4 text-gray-700">
										{% if reward.order_id %}
											<a href="{{ reward.href }}" class="text-primary hover:underline">{{ reward.description }}</a>
										{% else %}
											{{ reward.description }}
										{% endif %}
									</td>
									<td class="py-3 text-right font-medium text-gray-800">{{ reward.points }}</td>
								</tr>
							{% endfor %}
						{% else %}
							<tr>
								<td class="py-6 text-center text-neutral-500" colspan="3">{{ text_empty }}</td>
							</tr>
						{% endif %}
					</tbody>
				</table>
			</div>

			<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
				{% if results %}
					<p class="text-sm text-neutral-500">{{ results }}</p>
				{% endif %}
				{% include "default/components/pagination.twig" with { pagination: pagination_data } %}
			</div>

			<div class="mt-6">
				<a href="{{ continue }}" class="button-secondary">{{ button_continue }}</a>
			</div>
		</section>
	</div>
</div>
