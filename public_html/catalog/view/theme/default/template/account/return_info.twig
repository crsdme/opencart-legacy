<div id="account-return" class="container mx-auto pb-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-5xl px-2 pb-8">
		<div class="flex flex-col gap-6">
			<section class="rounded-lg bg-white p-6 shadow">
				<h1 class="mb-4 text-xl font-bold">{{ heading_title }}</h1>
				<div class="grid gap-6 text-sm text-gray-700 md:grid-cols-2">
					<div class="space-y-1">
						<p><span class="font-medium text-gray-800">{{ text_return_id }}</span> #{{ return_id }}</p>
						<p><span class="font-medium text-gray-800">{{ text_date_added }}</span> {{ date_added }}</p>
					</div>
					<div class="space-y-1">
						<p><span class="font-medium text-gray-800">{{ text_order_id }}</span> #{{ order_id }}</p>
						<p><span class="font-medium text-gray-800">{{ text_date_ordered }}</span> {{ date_ordered }}</p>
					</div>
				</div>
			</section>

			<section class="rounded-lg bg-white p-6 shadow">
				<h2 class="mb-4 text-lg font-semibold text-gray-800">{{ text_product }}</h2>
				<div class="grid gap-4 text-sm text-gray-700 sm:grid-cols-3">
					<div>
						<p class="mb-1 text-neutral-500">{{ column_product }}</p>
						<p class="font-medium text-gray-800">{{ product }}</p>
					</div>
					<div>
						<p class="mb-1 text-neutral-500">{{ column_model }}</p>
						<p>{{ model }}</p>
					</div>
					<div>
						<p class="mb-1 text-neutral-500">{{ column_quantity }}</p>
						<p>{{ quantity }}</p>
					</div>
				</div>
			</section>

			<section class="rounded-lg bg-white p-6 shadow">
				<h2 class="mb-4 text-lg font-semibold text-gray-800">{{ text_reason }}</h2>
				<div class="grid gap-4 text-sm text-gray-700 sm:grid-cols-3">
					<div>
						<p class="mb-1 text-neutral-500">{{ column_reason }}</p>
						<p>{{ reason }}</p>
					</div>
					<div>
						<p class="mb-1 text-neutral-500">{{ column_opened }}</p>
						<p>{{ opened }}</p>
					</div>
					<div>
						<p class="mb-1 text-neutral-500">{{ column_action }}</p>
						<p>{{ action }}</p>
					</div>
				</div>
			</section>

			{% if comment %}
				<section class="rounded-lg bg-white p-6 shadow">
					<h2 class="mb-3 text-lg font-semibold text-gray-800">{{ text_comment }}</h2>
					<div class="text-sm text-gray-700">{{ comment }}</div>
				</section>
			{% endif %}

			<section class="rounded-lg bg-white p-6 shadow">
				<h2 class="mb-4 text-lg font-semibold text-gray-800">{{ text_history }}</h2>
				<div class="overflow-x-auto">
					<table class="w-full min-w-[28rem] text-left text-sm">
						<thead>
							<tr class="border-b border-neutral-200 text-neutral-500">
								<th class="py-2 pr-4 font-medium">{{ column_date_added }}</th>
								<th class="py-2 pr-4 font-medium">{{ column_status }}</th>
								<th class="py-2 font-medium">{{ column_comment }}</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-neutral-100">
							{% if histories %}
								{% for history in histories %}
									<tr>
										<td class="py-3 pr-4 text-gray-700">{{ history.date_added }}</td>
										<td class="py-3 pr-4 text-gray-700">{{ history.status }}</td>
										<td class="py-3 text-gray-700">{{ history.comment }}</td>
									</tr>
								{% endfor %}
							{% else %}
								<tr>
									<td class="py-6 text-center text-neutral-500" colspan="3">{{ text_no_results }}</td>
								</tr>
							{% endif %}
						</tbody>
					</table>
				</div>
			</section>

			<div>
				<a href="{{ continue }}" class="button-secondary">{{ button_continue }}</a>
			</div>
		</div>
	</div>
</div>
