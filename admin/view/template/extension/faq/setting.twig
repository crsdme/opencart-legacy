{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="pull-right">
				<button type="submit" form="form-faq" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
					<i class="fa fa-save"></i>
				</button>
				<a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default">
					<i class="fa fa-reply"></i>
				</a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ul class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ul>
		</div>
	</div>
	<div class="container-fluid">
		{% if error_warning %}
			<div class="alert alert-danger alert-dismissible">
				<i class="fa fa-exclamation-circle"></i>
				{{ error_warning }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		{% if success %}
			<div class="alert alert-success alert-dismissible">
				<i class="fa fa-check-circle"></i>
				{{ success }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
			</div>
			<div class="panel-body">
				<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-faq" class="form-horizontal">
					<ul class="nav nav-tabs">
						<li class="active"><a href="#tab-settings" data-toggle="tab"><i class="fa fa-cog"></i> {{ text_settings }}</a></li>
						<li><a href="#tab-product" data-toggle="tab">{{ text_product }}</a></li>
						<li><a href="#tab-category" data-toggle="tab">{{ text_category }}</a></li>
						<li><a href="#tab-manufacturer" data-toggle="tab">{{ text_manufacturer }}</a></li>
					</ul>
					<div class="tab-content">
						<div class="tab-pane active" id="tab-settings">
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_status }}</label>
								<div class="col-sm-10">
									<select name="module_faq_status" class="form-control">
										{% if module_faq_status %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
									<p class="help-block">{{ help_status }}</p>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_enable_product }}</label>
								<div class="col-sm-10">
									<select name="module_faq_product" class="form-control">
										{% if module_faq_product %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
									<p class="help-block">{{ help_type }}</p>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_enable_category }}</label>
								<div class="col-sm-10">
									<select name="module_faq_category" class="form-control">
										{% if module_faq_category %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
									<p class="help-block">{{ help_type }}</p>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_enable_manufacturer }}</label>
								<div class="col-sm-10">
									<select name="module_faq_manufacturer" class="form-control">
										{% if module_faq_manufacturer %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
									<p class="help-block">{{ help_type }}</p>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_first_page_only }}</label>
								<div class="col-sm-10">
									<select name="module_faq_first_page_only" class="form-control">
										{% if module_faq_first_page_only %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
									<p class="help-block">{{ help_first_page_only }}</p>
								</div>
							</div>
							<div class="form-group">
								<label class="col-sm-2 control-label">{{ entry_delete_data }}</label>
								<div class="col-sm-10">
									<select name="module_faq_delete_data_on_uninstall" class="form-control">
										{% if module_faq_delete_data_on_uninstall %}
											<option value="1" selected="selected">{{ text_enabled }}</option>
											<option value="0">{{ text_disabled }}</option>
										{% else %}
											<option value="1">{{ text_enabled }}</option>
											<option value="0" selected="selected">{{ text_disabled }}</option>
										{% endif %}
									</select>
									<p class="help-block">{{ help_delete_data }}</p>
								</div>
							</div>
						</div>
						<div class="tab-pane" id="tab-product">
							{% for language in languages %}
								<div class="form-group">
									<label class="col-sm-2 control-label">
										{{ entry_title }}
										<img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" />
									</label>
									<div class="col-sm-10">
										<input type="text" name="module_faq_title_product[{{ language.language_id }}]" value="{{ module_faq_title_product[language.language_id] is defined ? module_faq_title_product[language.language_id] : '' }}" class="form-control" />
										<p class="help-block">{{ help_title }}</p>
									</div>
								</div>
							{% endfor %}
							{{ include('extension/faq/placeholders.twig', {
								placeholders: placeholders_product,
								help_placeholders: help_placeholders,
								help_placeholder_copy: help_placeholder_copy,
								text_copied: text_copied
							}) }}
							<legend>{{ text_global_faq }}</legend>
							{{ include('extension/faq/rows.twig', {
								table_id: 'faq-global-product',
								field_name: 'faq_global[product]',
								items: faq_global.product,
								languages: languages,
								text_enabled: text_enabled,
								text_disabled: text_disabled,
								column_question: column_question,
								column_answer: column_answer,
								column_sort_order: column_sort_order,
								column_status: column_status,
								button_add: button_add,
								button_remove: button_remove
							}) }}
						</div>
						<div class="tab-pane" id="tab-category">
							{% for language in languages %}
								<div class="form-group">
									<label class="col-sm-2 control-label">
										{{ entry_title }}
										<img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" />
									</label>
									<div class="col-sm-10">
										<input type="text" name="module_faq_title_category[{{ language.language_id }}]" value="{{ module_faq_title_category[language.language_id] is defined ? module_faq_title_category[language.language_id] : '' }}" class="form-control" />
										<p class="help-block">{{ help_title }}</p>
									</div>
								</div>
							{% endfor %}
							{{ include('extension/faq/placeholders.twig', {
								placeholders: placeholders_category,
								help_placeholders: help_placeholders,
								help_placeholder_copy: help_placeholder_copy,
								text_copied: text_copied
							}) }}
							<legend>{{ text_global_faq }}</legend>
							{{ include('extension/faq/rows.twig', {
								table_id: 'faq-global-category',
								field_name: 'faq_global[category]',
								items: faq_global.category,
								languages: languages,
								text_enabled: text_enabled,
								text_disabled: text_disabled,
								column_question: column_question,
								column_answer: column_answer,
								column_sort_order: column_sort_order,
								column_status: column_status,
								button_add: button_add,
								button_remove: button_remove
							}) }}
						</div>
						<div class="tab-pane" id="tab-manufacturer">
							{% for language in languages %}
								<div class="form-group">
									<label class="col-sm-2 control-label">
										{{ entry_title }}
										<img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" />
									</label>
									<div class="col-sm-10">
										<input type="text" name="module_faq_title_manufacturer[{{ language.language_id }}]" value="{{ module_faq_title_manufacturer[language.language_id] is defined ? module_faq_title_manufacturer[language.language_id] : '' }}" class="form-control" />
										<p class="help-block">{{ help_title }}</p>
									</div>
								</div>
							{% endfor %}
							{{ include('extension/faq/placeholders.twig', {
								placeholders: placeholders_manufacturer,
								help_placeholders: help_placeholders,
								help_placeholder_copy: help_placeholder_copy,
								text_copied: text_copied
							}) }}
							<legend>{{ text_global_faq }}</legend>
							{{ include('extension/faq/rows.twig', {
								table_id: 'faq-global-manufacturer',
								field_name: 'faq_global[manufacturer]',
								items: faq_global.manufacturer,
								languages: languages,
								text_enabled: text_enabled,
								text_disabled: text_disabled,
								column_question: column_question,
								column_answer: column_answer,
								column_sort_order: column_sort_order,
								column_status: column_status,
								button_add: button_add,
								button_remove: button_remove
							}) }}
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
{{ footer }}
