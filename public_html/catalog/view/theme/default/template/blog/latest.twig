{% set class = "col-span-12 " %}
{% if column_left and column_right %}
	{% set class = class ~ "lg:col-span-6" %}
{% elseif column_left or column_right %}
	{% set class = class ~ "lg:col-span-9" %}
{% else %}
	{% set class = class ~ "lg:col-span-12" %}
{% endif %}

<div class="container mx-auto px-2">
	{% include "default/components/breadcrumbs.twig" %}

	<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
		<h1 class="heading mb-0">{{ heading_title }}</h1>
		{% if text_total_articles %}
			<p class="text-muted text-base">
				{{ text_total_articles }}
			</p>
		{% endif %}
	</div>
</div>
<div class="container mx-auto grid grid-cols-1 gap-6 px-2 lg:grid-cols-12">
	{{ column_left }}
	<main class="{{ class }}">
		{{ content_top }}

		{% if articles %}
			<section class="mb-4 w-full" aria-label="{{ text_sort }}">
				<div class="flex flex-col items-center justify-end gap-2 lg:flex-row">
					<div class="dropdown w-full flex-1 lg:w-auto lg:flex-none" data-dropdown data-align="center" data-type="hover">
						<button class="button-secondary w-full" type="button" data-dropdown-button>
							{{ text_sort }}
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<use href="/assets/icons/sprite.svg#icon-chevron-down"></use>
							</svg>
						</button>

						<div class="dropdown-menu" data-dropdown-menu>
							{% for sort in sorts %}
								<button class="dropdown-item" onclick="location = '{{ sort.href }}'">{{ sort.text }}</button>
							{% endfor %}
						</div>
					</div>

					<div class="dropdown w-full flex-1 lg:w-auto lg:flex-none" data-dropdown data-align="center" data-type="hover">
						<button class="button-secondary w-full" type="button" data-dropdown-button>
							{{ text_limit }}
							<svg aria-hidden="true" viewBox="0 0 24 24">
								<use href="/assets/icons/sprite.svg#icon-chevron-down"></use>
							</svg>
						</button>

						<div class="dropdown-menu" data-dropdown-menu>
							{% for limit in limits %}
								<button class="dropdown-item" onclick="location = '{{ limit.href }}'">{{ limit.text }}</button>
							{% endfor %}
						</div>
					</div>
				</div>
			</section>

			<section class="grid grid-cols-2 gap-2 sm:gap-4 xl:grid-cols-3" aria-label="{{ heading_title }}">
				{% for article in articles %}
					{% include "default/components/article-card.twig" with {
						article: article,
						button_more: button_more
					} %}
				{% endfor %}
			</section>

			<section class="my-2 flex justify-between" aria-label="Pagination">
				{{
					include(
						"default/components/pagination.twig",
						{
							pagination: pagination_data
						}
					)
				}}
			</section>
		{% endif %}

		{% if not articles %}
			<section class="mx-auto my-8 w-full md:w-1/2" aria-label="Empty">
				<p class="heading">
					{{ text_empty }}
				</p>
				<a href="{{ continue }}" class="button button-primary mt-4">{{ button_continue }}</a>
			</section>
		{% endif %}

		{{ content_bottom }}
	</main>
	{{ column_right }}
</div>
