<div id="account-recurring" class="container mx-auto pb-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-5xl px-2 pb-8">
		<div class="flex flex-col gap-6">
			<section class="rounded-lg bg-white p-6 shadow">
				<h1 class="mb-4 text-xl font-bold">{{ heading_title }}</h1>
				<div class="grid gap-6 text-sm text-gray-700 md:grid-cols-2">
					<div class="space-y-1">
						<p><span class="font-medium text-gray-800">{{ text_order_recurring_id }}</span> #{{ order_recurring_id }}</p>
						<p><span class="font-medium text-gray-800">{{ text_date_added }}</span> {{ date_added }}</p>
						<p><span class="font-medium text-gray-800">{{ text_status }}</span> {{ status }}</p>
						<p><span class="font-medium text-gray-800">{{ text_payment_method }}</span> {{ payment_method }}</p>
					</div>
					<div class="space-y-1">
						<p><span class="font-medium text-gray-800">{{ text_order_id }}</span> <a href="{{ order }}" class="text-primary hover:underline">#{{ order_id }}</a></p>
						<p><span class="font-medium text-gray-800">{{ text_product }}</span> <a href="{{ product }}" class="text-primary hover:underline">{{ product_name }}</a></p>
						<p><span class="font-medium text-gray-800">{{ text_quantity }}</span> {{ product_quantity }}</p>
					</div>
				</div>
			</section>

			<section class="grid gap-6 md:grid-cols-2">
				<div class="rounded-lg bg-white p-6 shadow">
					<h2 class="mb-3 text-lg font-semibold text-gray-800">{{ text_description }}</h2>
					<div class="text-sm text-gray-700">{{ recurring_description }}</div>
				</div>
				<div class="rounded-lg bg-white p-6 shadow">
					<h2 class="mb-3 text-lg font-semibold text-gray-800">{{ text_reference }}</h2>
					<div class="text-sm text-gray-700">{{ reference }}</div>
				</div>
			</section>

			<section class="rounded-lg bg-white p-6 shadow">
				<h2 class="mb-4 text-lg font-semibold text-gray-800">{{ text_transaction }}</h2>
				<div class="overflow-x-auto">
					<table class="w-full min-w-[28rem] text-left text-sm">
						<thead>
							<tr class="border-b border-neutral-200 text-neutral-500">
								<th class="py-2 pr-4 font-medium">{{ column_date_added }}</th>
								<th class="py-2 pr-4 font-medium">{{ column_type }}</th>
								<th class="py-2 text-right font-medium">{{ column_amount }}</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-neutral-100">
							{% if transactions %}
								{% for transaction in transactions %}
									<tr>
										<td class="py-3 pr-4 text-gray-700">{{ transaction.date_added }}</td>
										<td class="py-3 pr-4 text-gray-700">{{ transaction.type }}</td>
										<td class="py-3 text-right font-medium text-gray-800">{{ transaction.amount }}</td>
									</tr>
								{% endfor %}
							{% else %}
								<tr>
									<td class="py-6 text-center text-neutral-500" colspan="3">{{ text_no_results }}</td>
								</tr>
							{% endif %}
						</tbody>
					</table>
				</div>
			</section>

			{% if recurring %}
				<section class="rounded-lg bg-white p-6 shadow">
					{{ recurring }}
				</section>
			{% endif %}
		</div>
	</div>
</div>
