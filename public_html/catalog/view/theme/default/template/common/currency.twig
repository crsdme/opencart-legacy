{% if (currencies | length) > 1 %}
	<form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-currency">
		<div class="flex flex-wrap gap-2">
			{% for currency in currencies %}
				<button
					class="button-secondary currency-select"
					data-size="small"
					type="button"
					name="{{ currency.code }}"
					{% if currency.code == code %}data-active="true"{% endif %}
				>
					{% if currency.symbol_left %}{{ currency.symbol_left }} {{ currency.code }}{% else %}{{ currency.code }} {{ currency.symbol_right }}{% endif %}
				</button>
			{% endfor %}
		</div>
		<input type="hidden" name="code" value="" />
		<input type="hidden" name="redirect" value="{{ redirect }}" />
	</form>
{% endif %}
