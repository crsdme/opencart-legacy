<div id="account-order" class="container mx-auto pb-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-5xl px-2 pb-8">
		{% if success %}
			<div class="relative mb-4 rounded border border-green-200 bg-green-100 px-4 py-3 text-green-500" role="alert">
				<span class="block sm:inline">{{ success }}</span>
			</div>
		{% endif %}
		{% if error_warning %}
			<div class="relative mb-4 rounded border border-red-200 bg-red-100 px-4 py-3 text-red-500" role="alert">
				<span class="block sm:inline">{{ error_warning }}</span>
			</div>
		{% endif %}

		<div class="flex flex-col gap-6">
			<section class="rounded-lg bg-white p-6 shadow">
				<h1 class="mb-4 text-xl font-bold">{{ heading_title }}</h1>
				<div class="grid gap-6 text-sm text-gray-700 md:grid-cols-2">
					<div class="space-y-1">
						{% if invoice_no %}
							<p><span class="font-medium text-gray-800">{{ text_invoice_no }}</span> {{ invoice_no }}</p>
						{% endif %}
						<p><span class="font-medium text-gray-800">{{ text_order_id }}</span> #{{ order_id }}</p>
						<p><span class="font-medium text-gray-800">{{ text_date_added }}</span> {{ date_added }}</p>
					</div>
					<div class="space-y-1">
						{% if payment_method %}
							<p><span class="font-medium text-gray-800">{{ text_payment_method }}</span> {{ payment_method }}</p>
						{% endif %}
						{% if shipping_method %}
							<p><span class="font-medium text-gray-800">{{ text_shipping_method }}</span> {{ shipping_method }}</p>
						{% endif %}
					</div>
				</div>
			</section>

			<section class="grid gap-6 md:grid-cols-2">
				<div class="rounded-lg bg-white p-6 shadow">
					<h2 class="mb-3 text-lg font-semibold text-gray-800">{{ text_payment_address }}</h2>
					<div class="text-sm leading-6 text-gray-700">{{ payment_address|raw }}</div>
				</div>
				{% if shipping_address %}
					<div class="rounded-lg bg-white p-6 shadow">
						<h2 class="mb-3 text-lg font-semibold text-gray-800">{{ text_shipping_address }}</h2>
						<div class="text-sm leading-6 text-gray-700">{{ shipping_address|raw }}</div>
					</div>
				{% endif %}
			</section>

			<section class="rounded-lg bg-white p-6 shadow">
				<div class="overflow-x-auto">
					<table class="w-full min-w-[36rem] text-left text-sm">
						<thead>
							<tr class="border-b border-neutral-200 text-neutral-500">
								<th class="py-2 pr-4 font-medium">{{ column_name }}</th>
								<th class="py-2 pr-4 font-medium">{{ column_model }}</th>
								<th class="py-2 pr-4 font-medium">{{ column_quantity }}</th>
								<th class="py-2 pr-4 font-medium">{{ column_price }}</th>
								<th class="py-2 pr-4 font-medium">{{ column_total }}</th>
								{% if products %}
									<th class="py-2 font-medium"></th>
								{% endif %}
							</tr>
						</thead>
						<tbody class="divide-y divide-neutral-100">
							{% for product in products %}
								<tr>
									<td class="py-3 pr-4 text-gray-800">
										{{ product.name }}
										{% for option in product.option %}
											<div class="text-xs text-neutral-500">{{ option.name }}: {{ option.value }}</div>
										{% endfor %}
									</td>
									<td class="py-3 pr-4 text-gray-700">{{ product.model }}</td>
									<td class="py-3 pr-4 text-gray-700">{{ product.quantity }}</td>
									<td class="py-3 pr-4 text-gray-700">{{ product.price }}</td>
									<td class="py-3 pr-4 font-medium text-gray-800">{{ product.total }}</td>
									<td class="py-3">
										<div class="flex flex-wrap justify-end gap-2">
											{% if product.reorder %}
												<a href="{{ product.reorder }}" class="button-primary">{{ button_reorder }}</a>
											{% endif %}
											<a href="{{ product.return }}" class="button-secondary">{{ button_return }}</a>
										</div>
									</td>
								</tr>
							{% endfor %}
							{% for voucher in vouchers %}
								<tr>
									<td class="py-3 pr-4 text-gray-800">{{ voucher.description }}</td>
									<td class="py-3 pr-4"></td>
									<td class="py-3 pr-4 text-gray-700">1</td>
									<td class="py-3 pr-4 text-gray-700">{{ voucher.amount }}</td>
									<td class="py-3 pr-4 font-medium text-gray-800">{{ voucher.amount }}</td>
									{% if products %}
										<td></td>
									{% endif %}
								</tr>
							{% endfor %}
						</tbody>
						<tfoot>
							{% for total in totals %}
								<tr class="border-t border-neutral-200">
									<td colspan="4" class="py-2 pr-4 text-right font-medium text-gray-800">{{ total.title }}</td>
									<td class="py-2 pr-4 font-medium text-gray-800">{{ total.text }}</td>
									{% if products %}
										<td></td>
									{% endif %}
								</tr>
							{% endfor %}
						</tfoot>
					</table>
				</div>
			</section>

			{% if comment %}
				<section class="rounded-lg bg-white p-6 shadow">
					<h2 class="mb-3 text-lg font-semibold text-gray-800">{{ text_comment }}</h2>
					<div class="text-sm text-gray-700">{{ comment }}</div>
				</section>
			{% endif %}

			{% if histories %}
				<section class="rounded-lg bg-white p-6 shadow">
					<h2 class="mb-4 text-lg font-semibold text-gray-800">{{ text_history }}</h2>
					<div class="overflow-x-auto">
						<table class="w-full min-w-[28rem] text-left text-sm">
							<thead>
								<tr class="border-b border-neutral-200 text-neutral-500">
									<th class="py-2 pr-4 font-medium">{{ column_date_added }}</th>
									<th class="py-2 pr-4 font-medium">{{ column_status }}</th>
									<th class="py-2 font-medium">{{ column_comment }}</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-neutral-100">
								{% for history in histories %}
									<tr>
										<td class="py-3 pr-4 text-gray-700">{{ history.date_added }}</td>
										<td class="py-3 pr-4 text-gray-700">{{ history.status }}</td>
										<td class="py-3 text-gray-700">{{ history.comment }}</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</section>
			{% endif %}

			<div>
				<a href="{{ continue }}" class="button-secondary">{{ button_continue }}</a>
			</div>
		</div>
	</div>
</div>
