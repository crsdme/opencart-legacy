{% set class = "col-span-12 " %}
{% if column_left and column_right %}
	{% set class = class ~ "lg:col-span-6" %}
{% elseif column_left or column_right %}
	{% set class = class ~ "lg:col-span-9" %}
{% else %}
	{% set class = class ~ "lg:col-span-12" %}
{% endif %}

<div class="container mx-auto px-2">
	{% include "default/components/breadcrumbs.twig" %}
</div>
<div class="container mx-auto grid grid-cols-1 gap-6 px-2 lg:grid-cols-12">
	{{ column_left }}
	<main class="{{ class }} pb-10">
		{{ content_top }}

		<div class="product-hero flex flex-col gap-8 lg:flex-row lg:items-start">
			{% if gallery %}
				<section class="product-hero-col w-full lg:w-1/2" aria-label="{{ heading_title }}">
					{% include "default/components/product-gallery.twig" %}
				</section>
			{% endif %}

			<section class="product-hero-col w-full {{ gallery ? "lg:w-1/2" : "" }}" aria-label="{{ heading_title }}">
				<div class="flex flex-col gap-3">
					<h1 class="heading mb-0">{{ heading_title }}</h1>

					<div class="flex flex-wrap items-center gap-3">
						{% if date_added %}
							<p class="text-muted mb-0">
								{{ date_added }}
							</p>
						{% endif %}
						{% if viewed is defined %}
							<p class="text-muted mb-0">
								{{ text_views }} {{ viewed }}
							</p>
						{% endif %}
						{% if review_status %}
							<div class="flex items-center gap-2">
								{% include "default/components/rating.twig" with {
									rating: rating
								} %}
								<a href="#reviews" class="text-muted link" data-scroll="#reviews">{{ reviews }}</a>
							</div>
						{% endif %}
					</div>
				</div>
			</section>
		</div>

		{% if toc %}
			<nav class="product-panel mt-10" aria-labelledby="article-toc-heading">
				<h2 id="article-toc-heading" class="heading">{{ text_toc }}</h2>
				<ul class="article-toc">
					{% for item in toc %}
						<li class="{{ item.level == 3 ? "article-toc-h3" : "" }}">
							<a class="link" href="#{{ item.id }}" data-scroll="#{{ item.id }}">{{ item.text }}</a>
						</li>
					{% endfor %}
				</ul>
			</nav>
		{% endif %}

		{% if description %}
			<section class="mt-10" aria-label="{{ heading_title }}">
				<div class="product-panel">
					<div class="content-block">
						{{ description }}
					</div>
				</div>
			</section>
		{% endif %}

		{% if download_status and downloads %}
			<section class="mt-10" aria-labelledby="article-downloads-heading">
				<h2 id="article-downloads-heading" class="heading">{{ text_downloads }}</h2>
				<div class="flex flex-col gap-2">
					{% for download in downloads %}
						<a class="button-secondary w-full justify-start sm:w-auto" href="{{ download.href }}">
							{{ download.name }}
							<span class="text-muted">{{ download.size }}</span>
						</a>
					{% endfor %}
				</div>
			</section>
		{% endif %}

		{% if products %}
			<section class="mt-10" aria-labelledby="article-related-products-heading">
				<h2 id="article-related-products-heading" class="heading">{{ text_related_product }}</h2>
				<div class="grid grid-cols-2 gap-2 sm:gap-4 xl:grid-cols-3">
					{% for product in products %}
						{% include "default/components/product-card.twig" with {
							product: product
						} %}
					{% endfor %}
				</div>
			</section>
		{% endif %}

		{% if articles %}
			<section class="mt-10" aria-labelledby="article-related-heading">
				<h2 id="article-related-heading" class="heading">{{ text_related }}</h2>
				<div class="grid grid-cols-2 gap-2 sm:gap-4 xl:grid-cols-3">
					{% for article in articles %}
						{% include "default/components/article-card.twig" with {
							article: article,
							button_more: button_more
						} %}
					{% endfor %}
				</div>
			</section>
		{% endif %}

		{% if author %}
			<section class="mt-10" aria-labelledby="article-author-heading">
				<div class="product-panel">
					<div class="article-author">
						{% if author.image %}
							{% if author.href %}
								<a href="{{ author.href }}" class="shrink-0">
									<img class="article-author-photo" src="{{ author.image }}" alt="{{ author.name }}" width="80" height="80" />
								</a>
							{% else %}
								<img class="article-author-photo" src="{{ author.image }}" alt="{{ author.name }}" width="80" height="80" />
							{% endif %}
						{% endif %}
						<div>
							<h2 id="article-author-heading" class="heading mb-1">
								{% if author.href %}
									<a class="link" href="{{ author.href }}">{{ author.name }}</a>
								{% else %}
									{{ author.name }}
								{% endif %}
							</h2>
							{% if author.excerpt %}
								<p class="text-muted mb-0">
									{{ author.excerpt }}
								</p>
							{% endif %}
						</div>
					</div>
				</div>
			</section>
		{% endif %}

		{% if review_status %}
			<section class="mb-10 mt-10" id="reviews" aria-labelledby="article-reviews-heading">
				<div class="flex flex-col gap-8 lg:flex-row lg:items-start">
					<div class="w-full lg:w-1/2">
						<h2 id="article-reviews-heading" class="heading">{{ tab_review }}</h2>
						<div id="review" data-review-url="{{ review_url }}"></div>
					</div>

					<form id="form-review" class="product-panel grid w-full gap-4 lg:w-1/2" data-write-url="{{ write_url }}">
						<h3 class="heading-5 mb-0">{{ text_write }}</h3>

						{% if review_guest %}
							<div class="form-item">
								<label class="form-label" for="input-name">{{ entry_name }}</label>
								<input class="input" type="text" name="name" value="{{ customer_name }}" id="input-name" />
							</div>
							<div class="form-item">
								<label class="form-label" for="input-review">{{ entry_review }}</label>
								<textarea class="input min-h-28 resize-y" name="text" rows="5" id="input-review"></textarea>
							</div>
							<div class="form-item">
								<span class="form-label">{{ entry_rating }}</span>
								{% include "default/components/rating.twig" with {
									interactive: true,
									name: "rating",
									id: "review-rating"
								} %}
							</div>
							{{ captcha }}
							<div class="form-item mb-0">
								<button type="button" id="button-review" class="button-primary">{{ button_continue }}</button>
							</div>
						{% else %}
							<p class="text">
								{{ text_login }}
							</p>
						{% endif %}
					</form>
				</div>
			</section>
		{% endif %}

		{{ content_bottom }}
	</main>
	{{ column_right }}
</div>
