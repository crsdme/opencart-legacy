{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
        <a href="{{ export }}" data-toggle="tooltip" title="{{ button_export }}" class="btn btn-default"><i class="fa fa-download"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    {% if dirty %}<div class="alert alert-warning">{{ text_config_dirty }} <a href="{{ config_url }}">{{ button_generate }}</a></div>{% endif %}
    {% include 'extension/redirect_manager/tabs.twig' %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title">{{ text_tab_rules }}</h3></div>
      <div class="panel-body">
        <div class="well">
          <div class="row">
            <div class="col-sm-3"><input type="text" name="filter_source" value="{{ filter_source }}" placeholder="{{ column_source }}" class="form-control" /></div>
            <div class="col-sm-3"><input type="text" name="filter_target" value="{{ filter_target }}" placeholder="{{ column_target }}" class="form-control" /></div>
            <div class="col-sm-2">
              <select name="filter_http_code" class="form-control">
                <option value="">{{ column_code }}</option>
                {% for code in http_codes %}<option value="{{ code }}"{% if filter_http_code == code %} selected="selected"{% endif %}>{{ code }}</option>{% endfor %}
              </select>
            </div>
            <div class="col-sm-2">
              <select name="filter_action" class="form-control">
                <option value="">{{ column_action }}</option>
                <option value="redirect"{% if filter_action == 'redirect' %} selected="selected"{% endif %}>{{ text_action_redirect }}</option>
                <option value="status"{% if filter_action == 'status' %} selected="selected"{% endif %}>{{ text_action_status }}</option>
              </select>
            </div>
            <div class="col-sm-2">
              <button type="button" id="button-filter" class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter }}</button>
            </div>
          </div>
          <div class="row" style="margin-top:10px">
            <div class="col-sm-2">
              <select name="filter_enabled" class="form-control">
                <option value="">{{ column_status }}</option>
                <option value="1"{% if filter_enabled == '1' %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if filter_enabled == '0' %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
            <div class="col-sm-2"><label class="checkbox-inline"><input type="checkbox" name="filter_broken" value="1"{% if filter_broken %} checked="checked"{% endif %} /> {{ text_broken }}</label></div>
          </div>
        </div>
        <form method="post" action="{{ bulk }}" id="form-rule">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td width="1"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                  <td>{{ column_id }}</td>
                  <td>{{ column_source }}</td>
                  <td>{{ column_target }}</td>
                  <td>{{ column_action }}</td>
                  <td>{{ column_code }}</td>
                  <td>{{ column_source_type }}</td>
                  <td>{{ column_status }}</td>
                  <td>{{ column_date }}</td>
                  <td>{{ column_action }}</td>
                </tr>
              </thead>
              <tbody>
                {% if rules %}
                {% for rule in rules %}
                <tr>
                  <td><input type="checkbox" name="selected[]" value="{{ rule.redirect_id }}" /></td>
                  <td>{{ rule.redirect_id }}</td>
                  <td>{{ rule.source_url }}</td>
                  <td>{{ rule.target_url }}</td>
                  <td>{{ rule.action }}</td>
                  <td>{{ rule.http_code }}</td>
                  <td>{{ rule.source_type }}{% if rule.source_entity_id %} #{{ rule.source_entity_id }}{% endif %}</td>
                  <td>{% if rule.enabled %}{{ text_enabled }}{% else %}{{ text_disabled }}{% endif %}</td>
                  <td>{{ rule.date_modified }}</td>
                  <td class="text-right"><a href="{{ rule.edit }}" class="btn btn-primary btn-xs"><i class="fa fa-pencil"></i></a></td>
                </tr>
                {% endfor %}
                {% else %}
                <tr><td colspan="10" class="text-center">{{ text_no_results }}</td></tr>
                {% endif %}
              </tbody>
            </table>
          </div>
          {% if can_modify %}
          <div class="form-inline">
            <select name="bulk_action" class="form-control">
              <option value="enable">{{ text_enabled }}</option>
              <option value="disable">{{ text_disabled }}</option>
              <option value="delete">{{ button_delete }}</option>
              <option value="http_code">{{ entry_http_code }}</option>
              <option value="destination">{{ entry_target }}</option>
              <option value="export">{{ button_export }}</option>
            </select>
            <input type="text" name="bulk_http_code" value="301" class="form-control" style="width:80px" />
            <input type="text" name="bulk_target" value="" placeholder="{{ entry_target }}" class="form-control" />
            <button type="submit" class="btn btn-default" onclick="return confirm('{{ text_confirm }}');">{{ button_save }}</button>
          </div>
          {% endif %}
        </form>
        <div class="row"><div class="col-sm-6 text-left">{{ pagination }}</div><div class="col-sm-6 text-right">{{ results }}</div></div>
      </div>
    </div>
  </div>
</div>
<script>
$('#button-filter').on('click', function() {
  var url = 'index.php?route=extension/redirect_manager/rule&user_token={{ user_token }}';
  $('.well input, .well select').each(function() {
    var v = $(this).is(':checkbox') ? ($(this).prop('checked') ? 1 : '') : $(this).val();
    if (v) url += '&' + $(this).attr('name') + '=' + encodeURIComponent(v);
  });
  location = url;
});
</script>
{{ footer }}
