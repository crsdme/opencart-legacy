<div class="table-responsive">
	<table id="{{ table_id }}" class="table table-striped table-bordered table-hover">
		<thead>
			<tr>
				<td class="text-left">{{ column_question }}</td>
				<td class="text-left">{{ column_answer }}</td>
				<td class="text-center" style="width:90px;">{{ column_sort_order }}</td>
				<td class="text-center" style="width:120px;">{{ column_status }}</td>
				<td style="width:50px;"></td>
			</tr>
		</thead>
		<tbody>
			{% set faq_row = 0 %}
			{% for item in items %}
				<tr id="{{ table_id }}-row{{ faq_row }}">
					<td>
						{% for language in languages %}
							{% set lang_faq = item.faq_data[language.language_id]|default({}) %}
							<div class="input-group" style="margin-bottom:6px;">
								<span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
								<input type="text" name="{{ field_name }}[{{ faq_row }}][faq_data][{{ language.language_id }}][question]" value="{{ lang_faq.question|default('') }}" class="form-control" />
							</div>
						{% endfor %}
					</td>
					<td>
						{% for language in languages %}
							{% set lang_faq = item.faq_data[language.language_id]|default({}) %}
							<div class="input-group" style="margin-bottom:6px;">
								<span class="input-group-addon"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /></span>
								<textarea name="{{ field_name }}[{{ faq_row }}][faq_data][{{ language.language_id }}][answer]" rows="3" class="form-control">{{ lang_faq.answer|default('') }}</textarea>
							</div>
						{% endfor %}
					</td>
					<td class="text-center">
						<input type="text" name="{{ field_name }}[{{ faq_row }}][sort_order]" value="{{ item.sort_order }}" class="form-control" />
					</td>
					<td class="text-center">
						<select name="{{ field_name }}[{{ faq_row }}][status]" class="form-control">
							{% if item.status %}
								<option value="1" selected="selected">{{ text_enabled }}</option>
								<option value="0">{{ text_disabled }}</option>
							{% else %}
								<option value="1">{{ text_enabled }}</option>
								<option value="0" selected="selected">{{ text_disabled }}</option>
							{% endif %}
						</select>
					</td>
					<td class="text-center">
						<button type="button" onclick="$('#{{ table_id }}-row{{ faq_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger">
							<i class="fa fa-minus-circle"></i>
						</button>
					</td>
				</tr>
				{% set faq_row = faq_row + 1 %}
			{% endfor %}
		</tbody>
		<tfoot>
			<tr>
				<td colspan="4"></td>
				<td class="text-center">
					<button type="button" onclick="faqAddRow('{{ table_id }}', '{{ field_name }}');" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary">
						<i class="fa fa-plus-circle"></i>
					</button>
				</td>
			</tr>
		</tfoot>
	</table>
</div>
<script type="text/javascript">
if (typeof faqRows === 'undefined') {
	var faqRows = {};
	var faqLanguages = {{ languages|json_encode|raw }};
	var faqTextEnabled = {{ text_enabled|json_encode|raw }};
	var faqTextDisabled = {{ text_disabled|json_encode|raw }};
	var faqTextRemove = {{ button_remove|json_encode|raw }};
	function faqAddRow(tableId, fieldName) {
		if (typeof faqRows[tableId] === 'undefined') {
			faqRows[tableId] = $('#' + tableId + ' tbody tr').length;
		}
		var row = faqRows[tableId];
		var html = '<tr id="' + tableId + '-row' + row + '">';
		html += '<td>';
		$.each(faqLanguages, function(index, language) {
			html += '<div class="input-group" style="margin-bottom:6px;">';
			html += '<span class="input-group-addon"><img src="language/' + language.code + '/' + language.code + '.png" title="' + language.name + '" /></span>';
			html += '<input type="text" name="' + fieldName + '[' + row + '][faq_data][' + language.language_id + '][question]" value="" class="form-control" />';
			html += '</div>';
		});
		html += '</td><td>';
		$.each(faqLanguages, function(index, language) {
			html += '<div class="input-group" style="margin-bottom:6px;">';
			html += '<span class="input-group-addon"><img src="language/' + language.code + '/' + language.code + '.png" title="' + language.name + '" /></span>';
			html += '<textarea name="' + fieldName + '[' + row + '][faq_data][' + language.language_id + '][answer]" rows="3" class="form-control"></textarea>';
			html += '</div>';
		});
		html += '</td>';
		html += '<td class="text-center"><input type="text" name="' + fieldName + '[' + row + '][sort_order]" value="' + row + '" class="form-control" /></td>';
		html += '<td class="text-center"><select name="' + fieldName + '[' + row + '][status]" class="form-control">';
		html += '<option value="1" selected="selected">' + faqTextEnabled + '</option>';
		html += '<option value="0">' + faqTextDisabled + '</option></select></td>';
		html += '<td class="text-center"><button type="button" onclick="$(\'#' + tableId + '-row' + row + '\').remove();" data-toggle="tooltip" title="' + faqTextRemove + '" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
		html += '</tr>';
		$('#' + tableId + ' tbody').append(html);
		faqRows[tableId]++;
	}
}
faqRows[{{ table_id|json_encode|raw }}] = {{ faq_row }};
</script>
