{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        {% if can_modify %}
        <a href="{{ generate }}" class="btn btn-primary">{{ button_generate }}</a>
        <a href="{{ sync_url }}" class="btn btn-default">{{ button_sync }}</a>
        {% endif %}
        <a href="{{ download }}" class="btn btn-default">{{ button_download }}</a>
        <a href="{{ read }}" class="btn btn-default">{{ button_read_backend }}</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    {% if dirty %}<div class="alert alert-warning">{{ text_config_dirty }}</div>{% endif %}
    {% if loops %}<div class="alert alert-danger">{{ error_loop }}</div>{% endif %}
    {% include 'extension/redirect_manager/tabs.twig' %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title">{{ text_tab_config }}</h3></div>
      <div class="panel-body">
        <table class="table table-bordered">
          <tr><td>{{ text_backend }}</td><td>{{ backend }}</td></tr>
          <tr><td>{{ text_generated_file }}</td><td>{{ generated.path }}</td></tr>
          <tr><td>{{ text_total_rules }}</td><td>{{ generated.count }}</td></tr>
          <tr><td>{{ text_rules_hash }}</td><td><code>{{ generated.hash }}</code></td></tr>
          <tr><td>{{ text_last_generated }}</td><td>{{ sync.date_generated }}</td></tr>
          <tr><td>{{ text_last_sync }}</td><td>{{ sync.date_synced }}</td></tr>
          <tr><td>{{ column_status }}</td><td>{{ sync.status }}</td></tr>
        </table>
        {% if backend == 'nginx' %}<p><code>include {{ include_hint }};</code></p>{% endif %}
        {% if generated.warning %}
        <div class="alert alert-info">{% for w in generated.warning %}{{ w }}<br />{% endfor %}</div>
        {% endif %}
        {% if generated.errors %}
        <div class="alert alert-danger">{% for err in generated.errors %}{{ err.error }} {{ err.source }}<br />{% endfor %}</div>
        {% endif %}
        <pre style="max-height:400px;overflow:auto">{{ generated.content }}</pre>
        {% if compare %}
        <h4>{{ text_compare }}</h4>
        <p>{{ text_db_only }}: {{ compare.db_only }} | {{ text_backend_only }}: {{ compare.backend_only }} | {{ text_different }}: {{ compare.different }} | {{ text_synced }}: {{ compare.synced }}</p>
        {% if can_modify %}<a href="{{ read }}&import_backend=1" class="btn btn-default">{{ button_import }}</a>{% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
