{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header"><div class="container-fluid"><h1>{{ heading_title }}</h1>
    <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul></div></div>
  <div class="container-fluid">
    {% include 'extension/redirect_manager/tabs.twig' %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title">{{ text_tab_logs }}</h3></div>
      <div class="panel-body">
        <table class="table table-bordered table-hover">
          <thead><tr><td>{{ column_date }}</td><td>{{ column_action }}</td><td>{{ text_backend }}</td><td>{{ column_status }}</td><td>{{ column_message }}</td></tr></thead>
          <tbody>
          {% if logs %}
          {% for log in logs %}
          <tr><td>{{ log.date_added }}</td><td>{{ log.action }}</td><td>{{ log.backend }}</td><td>{{ log.result }}</td><td>{{ log.message }}</td></tr>
          {% endfor %}
          {% else %}
          <tr><td colspan="5" class="text-center">{{ text_no_results }}</td></tr>
          {% endif %}
          </tbody>
        </table>
        <div class="row"><div class="col-sm-6">{{ pagination }}</div><div class="col-sm-6 text-right">{{ results }}</div></div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
