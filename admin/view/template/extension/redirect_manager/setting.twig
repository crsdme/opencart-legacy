{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        {% if can_modify %}<button type="submit" form="form-setting" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>{% endif %}
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>{% endif %}
    {% include 'extension/redirect_manager/tabs.twig' %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-cog"></i> {{ text_tab_settings }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-setting" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_redirect_manager_status" class="form-control">
                <option value="1"{% if module_redirect_manager_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not module_redirect_manager_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_backend }}</label>
            <div class="col-sm-10">
              <select name="module_redirect_manager_backend" id="input-backend" class="form-control">
                <option value="apache"{% if module_redirect_manager_backend == 'apache' %} selected="selected"{% endif %}>Apache</option>
                <option value="nginx"{% if module_redirect_manager_backend == 'nginx' %} selected="selected"{% endif %}>Nginx</option>
                <option value="cloudflare"{% if module_redirect_manager_backend == 'cloudflare' %} selected="selected"{% endif %}>Cloudflare</option>
                <option value="php"{% if module_redirect_manager_backend == 'php' %} selected="selected"{% endif %}>{{ text_php_fallback }}</option>
              </select>
            </div>
          </div>
          <div class="backend-box" data-backend="apache">
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_apache_mode }}</label>
              <div class="col-sm-10">
                <select name="module_redirect_manager_apache_mode" class="form-control">
                  <option value="file"{% if module_redirect_manager_apache_mode == 'file' %} selected="selected"{% endif %}>{{ text_apache_file }}</option>
                  <option value="htaccess"{% if module_redirect_manager_apache_mode == 'htaccess' %} selected="selected"{% endif %}>{{ text_apache_htaccess }}</option>
                </select>
                <p class="help-block">{{ help_apache_mode }}</p>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_apache_file }}</label>
              <div class="col-sm-10"><input type="text" name="module_redirect_manager_apache_file" value="{{ module_redirect_manager_apache_file }}" class="form-control" />
                <p class="help-block">{{ htaccess_path }}</p></div>
            </div>
          </div>
          <div class="backend-box" data-backend="nginx">
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_nginx_file }}</label>
              <div class="col-sm-10">
                <input type="text" name="module_redirect_manager_nginx_file" value="{{ module_redirect_manager_nginx_file }}" class="form-control" />
                <p class="help-block">include {{ module_redirect_manager_nginx_file }};</p>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_allow_reload }}</label>
              <div class="col-sm-10">
                <label class="radio-inline"><input type="radio" name="module_redirect_manager_allow_reload" value="1"{% if module_redirect_manager_allow_reload %} checked="checked"{% endif %} /> {{ text_yes }}</label>
                <label class="radio-inline"><input type="radio" name="module_redirect_manager_allow_reload" value="0"{% if not module_redirect_manager_allow_reload %} checked="checked"{% endif %} /> {{ text_no }}</label>
                <p class="help-block">{{ help_allow_reload }}</p>
              </div>
            </div>
          </div>
          <div class="backend-box" data-backend="cloudflare">
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_cf_token }}</label>
              <div class="col-sm-10"><input type="password" name="module_redirect_manager_cloudflare_token" value="{{ module_redirect_manager_cloudflare_token }}" class="form-control" autocomplete="new-password" />
                <p class="help-block">{{ help_cf_token }}{% if has_token %} {{ text_token_saved }}{% endif %}</p></div>
            </div>
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_cf_account }}</label><div class="col-sm-10"><input type="text" name="module_redirect_manager_cloudflare_account_id" value="{{ module_redirect_manager_cloudflare_account_id }}" class="form-control" /></div></div>
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_cf_list }}</label><div class="col-sm-10"><input type="text" name="module_redirect_manager_cloudflare_list_id" value="{{ module_redirect_manager_cloudflare_list_id }}" class="form-control" /></div></div>
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_cf_rule }}</label><div class="col-sm-10"><input type="text" name="module_redirect_manager_cloudflare_rule_id" value="{{ module_redirect_manager_cloudflare_rule_id }}" class="form-control" /></div></div>
            <div class="form-group"><label class="col-sm-2 control-label">{{ entry_cf_domain }}</label><div class="col-sm-10"><input type="text" name="module_redirect_manager_cloudflare_domain" value="{{ module_redirect_manager_cloudflare_domain }}" placeholder="https://example.com" class="form-control" /></div></div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_sync_mode }}</label>
              <div class="col-sm-10">
                <select name="module_redirect_manager_sync_mode" class="form-control">
                  <option value="manual"{% if module_redirect_manager_sync_mode == 'manual' %} selected="selected"{% endif %}>{{ text_sync_manual }}</option>
                  <option value="cron"{% if module_redirect_manager_sync_mode == 'cron' %} selected="selected"{% endif %}>{{ text_sync_cron }}</option>
                  <option value="auto"{% if module_redirect_manager_sync_mode == 'auto' %} selected="selected"{% endif %}>{{ text_sync_auto }}</option>
                </select>
              </div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_allowed_paths }}</label>
            <div class="col-sm-10"><textarea name="module_redirect_manager_allowed_paths" rows="3" class="form-control">{{ module_redirect_manager_allowed_paths }}</textarea>
              <p class="help-block">{{ help_allowed_paths }} {{ storage_root }}</p></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_auto_seo }}</label>
            <div class="col-sm-10">
              <label class="radio-inline"><input type="radio" name="module_redirect_manager_auto_seo_redirect" value="1"{% if module_redirect_manager_auto_seo_redirect %} checked="checked"{% endif %} /> {{ text_yes }}</label>
              <label class="radio-inline"><input type="radio" name="module_redirect_manager_auto_seo_redirect" value="0"{% if not module_redirect_manager_auto_seo_redirect %} checked="checked"{% endif %} /> {{ text_no }}</label>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_deleted_product }}</label>
            <div class="col-sm-10">
              <select name="module_redirect_manager_deleted_product_action" class="form-control">
                <option value="none"{% if module_redirect_manager_deleted_product_action == 'none' %} selected="selected"{% endif %}>{{ text_do_nothing }}</option>
                <option value="ask"{% if module_redirect_manager_deleted_product_action == 'ask' %} selected="selected"{% endif %}>{{ text_ask }}</option>
                <option value="410"{% if module_redirect_manager_deleted_product_action == '410' %} selected="selected"{% endif %}>410 Gone</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_delete_data }}</label>
            <div class="col-sm-10">
              <label class="radio-inline"><input type="radio" name="module_redirect_manager_delete_data_on_uninstall" value="1"{% if module_redirect_manager_delete_data_on_uninstall %} checked="checked"{% endif %} /> {{ text_yes }}</label>
              <label class="radio-inline"><input type="radio" name="module_redirect_manager_delete_data_on_uninstall" value="0"{% if not module_redirect_manager_delete_data_on_uninstall %} checked="checked"{% endif %} /> {{ text_no }}</label>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
$('#input-backend').on('change', function() {
  var v = $(this).val();
  $('.backend-box').hide().filter('[data-backend="'+v+'"]').show();
}).trigger('change');
</script>
{{ footer }}
