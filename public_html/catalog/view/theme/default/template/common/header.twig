<header class="header">
	{% if text_announcement %}
		<div class="header-top">
			<div class="header-top-inner container mx-auto">
				<p class="header-top-text">
					{{ text_announcement }}
				</p>
			</div>
		</div>
	{% endif %}

	<div class="header-main">
		<div class="header-main-inner container mx-auto flex items-center gap-2 px-2 lg:gap-4">
			<button class="button-ghost" type="button" data-type="icon" data-sheet-open="left-sheet" aria-label="{{ text_menu }}">
				<svg aria-hidden="true" viewbox="0 0 24 24">
					<use href="/assets/icons/sprite.svg#icon-menu"></use>
				</svg>
			</button>
			{% if "common/home" == route %}
				<svg class="header-logo" aria-hidden="true" width="100" height="31">
					<use href="/assets/icons/sprite.svg#logo"></use>
				</svg>
			{% else %}
				<a class="header-logo" href="{{ home }}">
					<svg aria-hidden="true" width="100" height="31">
						<use href="/assets/icons/sprite.svg#logo"></use>
					</svg>
				</a>
			{% endif %}
			<div class="min-w-0 flex-1">
				{{ search }}
			</div>
			<div class="flex shrink-0 items-center gap-2">
				<div class="dropdown" data-dropdown data-align="right" data-type="hover">
					<button class="button-secondary" type="button" data-type="icon" data-dropdown-button aria-label="{{ text_contacts }}">
						<svg aria-hidden="true" viewbox="0 0 24 24">
							<use href="/assets/icons/sprite.svg#icon-phone"></use>
						</svg>
					</button>

					<div class="dropdown-menu" data-dropdown-menu>
						<a class="dropdown-item" href="tel:+380668875507">+38 (123) 456 7890</a>
						<a class="dropdown-item" href="mailto:info@example.com">info@example.com</a>
						<a class="dropdown-item" href="https://wa.me/905314918688">+90 531 491 8688</a>
					</div>
				</div>
				{{ cart }}
			</div>
		</div>
	</div>
</header>

<template id="toast-template">
	<div class="toast" data-type="default">
		<div class="toast-content">
			<div class="toast-text">
				<div class="toast-title"></div>
				<div class="toast-description"></div>
			</div>

			<button class="toast-action button-secondary" data-size="small" type="button"></button>

			<button class="toast-close button-ghost" data-type="icon" data-size="small" type="button" aria-label="Close toast">
				<svg aria-hidden="true" viewBox="0 0 24 24">
					<use href="/assets/icons/sprite.svg#icon-close"></use>
				</svg>
			</button>
		</div>
	</div>
</template>

{{ menu }}
