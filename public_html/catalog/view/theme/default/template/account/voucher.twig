<div id="account-voucher" class="container mx-auto pb-4">
	<div class="mx-auto px-2">
		{% include "default/components/breadcrumbs.twig" %}
	</div>

	<div class="mx-auto max-w-lg px-2 pb-8">
		<section class="flex flex-col rounded-lg bg-white p-6 shadow">
			<h1 class="mb-2 text-xl font-bold">{{ heading_title }}</h1>
			<p class="mb-4 text-neutral-500">{{ text_description }}</p>

			{% if error_warning %}
				<div class="relative mb-4 rounded border border-red-200 bg-red-100 px-4 py-3 text-red-500" role="alert">
					<span class="block sm:inline">{{ error_warning }}</span>
				</div>
			{% endif %}

			<form action="{{ action }}" method="post" enctype="multipart/form-data" class="flex flex-col gap-4">
				<div>
					<label for="input-to-name" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_to_name }}</label>
					<input type="text" name="to_name" value="{{ to_name }}" id="input-to-name" class="input w-full" />
					{% if error_to_name %}
						<p class="form-message">{{ error_to_name }}</p>
					{% endif %}
				</div>
				<div>
					<label for="input-to-email" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_to_email }}</label>
					<input type="email" name="to_email" value="{{ to_email }}" id="input-to-email" class="input w-full" />
					{% if error_to_email %}
						<p class="form-message">{{ error_to_email }}</p>
					{% endif %}
				</div>
				<div>
					<label for="input-from-name" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_from_name }}</label>
					<input type="text" name="from_name" value="{{ from_name }}" id="input-from-name" class="input w-full" />
					{% if error_from_name %}
						<p class="form-message">{{ error_from_name }}</p>
					{% endif %}
				</div>
				<div>
					<label for="input-from-email" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_from_email }}</label>
					<input type="email" name="from_email" value="{{ from_email }}" id="input-from-email" class="input w-full" />
					{% if error_from_email %}
						<p class="form-message">{{ error_from_email }}</p>
					{% endif %}
				</div>
				<div>
					<span class="mb-2 block text-sm font-medium text-gray-700">{{ entry_theme }}</span>
					<div class="grid gap-2">
						{% for voucher_theme in voucher_themes %}
							<label class="flex items-center gap-2 text-sm">
								<input type="radio" name="voucher_theme_id" value="{{ voucher_theme.voucher_theme_id }}" class="radio"{% if voucher_theme.voucher_theme_id == voucher_theme_id %} checked="checked"{% endif %} />
								<span>{{ voucher_theme.name }}</span>
							</label>
						{% endfor %}
					</div>
					{% if error_theme %}
						<p class="form-message">{{ error_theme }}</p>
					{% endif %}
				</div>
				<div>
					<label for="input-message" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_message }}</label>
					<p class="mb-2 text-sm text-neutral-500">{{ help_message }}</p>
					<textarea name="message" id="input-message" rows="5" class="input min-h-28 w-full resize-y">{{ message }}</textarea>
				</div>
				<div>
					<label for="input-amount" class="mb-1 block text-sm font-medium text-gray-700">{{ entry_amount }}</label>
					<p class="mb-2 text-sm text-neutral-500">{{ help_amount }}</p>
					<input type="text" name="amount" value="{{ amount }}" id="input-amount" class="input w-full" />
					{% if error_amount %}
						<p class="form-message">{{ error_amount }}</p>
					{% endif %}
				</div>
				{% if text_agree %}
					<label class="flex items-start gap-2 text-sm text-gray-700">
						<input type="checkbox" name="agree" value="1" class="checkbox mt-0.5"{% if agree %} checked="checked"{% endif %} />
						<span>{{ text_agree|raw }}</span>
					</label>
				{% endif %}
				<button type="submit" class="button-primary w-full">{{ button_continue }}</button>
			</form>
		</section>
	</div>
</div>
