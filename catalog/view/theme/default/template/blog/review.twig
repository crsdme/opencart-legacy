{% if reviews %}
	<div class="flex flex-col gap-4">
		{% for review in reviews %}
			<article class="product-review">
				<div class="flex flex-wrap items-start justify-between gap-2">
					<div>
						<p class="text-em mb-1">
							{{ review.author }}
						</p>
						{% include "default/components/rating.twig" with {
							rating: review.rating
						} %}
					</div>
					<p class="text-muted">
						{{ review.date_added }}
					</p>
				</div>
				<p class="text mb-0 mt-3">
					{{ review.text }}
				</p>
			</article>
		{% endfor %}

		{{
			include(
				"default/components/pagination.twig",
				{
					pagination: pagination_data
				}
			)
		}}
	</div>
{% else %}
	<p class="product-review text-muted">
		{{ text_no_reviews }}
	</p>
{% endif %}
